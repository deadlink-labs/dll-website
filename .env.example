# Deadlink Labs — environment variables (copy to .env, never commit real values)

# Content pipeline (CLAUDE.md §4): the site repo gitignores content/ and a
# prebuild step shallow-clones the private content repo into ./content.
# On Vercel this uses a stored read token.
CONTENT_REPO_URL=
CONTENT_REPO_TOKEN=

# Resend — contact + waitlist forms (added later in the build order).
RESEND_API_KEY=
