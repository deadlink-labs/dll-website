---
// /thank-you — where /api/contact redirects after a successful send.
//
// Prerendered like the rest of the site; only the endpoint that redirects here
// runs on demand. `noindex` is set explicitly rather than relying on the
// site-wide switch, because this page stays meaningless to search even after
// LOG 004 opens the site up: it is only true for someone who just sent a form.
//
// Register is the product-page row of VOICE.md §3 (human, direct, second
// person, contractions on) — the same voice as the Work-with-me section this
// page follows. Someone just took a real action; they get a plain answer.
import BaseLayout from '../layouts/BaseLayout.astro';
import Stamp from '../components/Stamp.astro';
---

<BaseLayout
  title="Message received"
  description="Your message reached Marcelo Brouard at Deadlink Labs."
  noindex
>
  <article class="sent">
    <Stamp label="MESSAGE RECEIVED" />
    <h1 class="sent__title">Got it.</h1>
    <div class="prose">
      <p>
        Your message is in my inbox. I read every one myself, so the reply comes from me
        and not a template. Usually within a day or two.
      </p>
      <p>
        While you wait, <a href="/log">the log</a> is where the work lives.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .sent {
    padding-block: 3rem 6rem;
    max-width: 720px;
  }

  .sent__title {
    margin: 1.25rem 0 1.5rem;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    font-weight: 600;
  }

  .prose {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .prose p {
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }
</style>
