---
// Product page (/products/<slug>) — CLAUDE.md §5.3.
// Overview + status + related. COMING SOON products show a waitlist. The form is
// UI only in v1 — wiring to Resend Audiences arrives later in the build order
// (§4), so it does not post anywhere yet.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusDot from '../../components/StatusDot.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedProducts } from '../../lib/content';

export const getStaticPaths = (async () => {
  const products = await getPublishedProducts();
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const comingSoon = entry.data.stage === 'COMING SOON';
---

<BaseLayout width="record" title={entry.data.title} description={entry.data.snippet}>
  <article class="product-page">
    <p class="product-page__eyebrow">Deadlink Labs / Products</p>
    <h1 class="product-page__title">{entry.data.title}</h1>
    <div class="product-page__status">
      <StatusDot stage={entry.data.stage} />
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      comingSoon && (
        <section class="waitlist" aria-labelledby="waitlist-heading">
          <h2 id="waitlist-heading" class="waitlist__heading">Join the waitlist</h2>
          <p class="waitlist__note">Get told when it opens. No spam, one email when it is ready.</p>
          <form class="waitlist__form" method="post" action="#" data-placeholder="not wired to Resend yet">
            <label class="waitlist__label" for="wl-email">Email</label>
            <div class="waitlist__row">
              <input class="waitlist__input" id="wl-email" name="email" type="email" placeholder="you@example.com" required />
              <button class="waitlist__btn" type="submit">Join the waitlist</button>
            </div>
          </form>
        </section>
      )
    }

    <p class="product-page__back"><a href="/products">← All products</a></p>
  </article>

  <Footer />
</BaseLayout>

<style>
  .product-page {
    padding-block: 1rem 1.5rem;
    max-width: 720px;
  }
  .product-page__eyebrow {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
  }
  .product-page__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .product-page__status {
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .prose {
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .prose :global(p) {
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }

  .waitlist {
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
  }
  .waitlist__heading {
    margin: 0 0 0.5rem;
    font-size: 20px;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .waitlist__note {
    margin: 0 0 1.25rem;
    font-size: 15px;
    color: var(--color-ink-60);
  }
  .waitlist__label {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-60);
  }
  .waitlist__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .waitlist__input {
    flex: 1 1 220px;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 15px;
    background: var(--color-paper);
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    color: var(--color-ink);
  }
  .waitlist__input:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 1px;
  }
  .waitlist__btn {
    padding: 0.7rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--color-signal);
    border: 1px solid var(--color-signal);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .waitlist__btn:hover {
    background: #d64300;
  }
  .waitlist__btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .product-page__back {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink-15);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .product-page__back a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .product-page__back a:hover {
    color: var(--color-signal);
  }
</style>
