---
// Product page (/products/<slug>) — CLAUDE.md §5.3.
// Overview + status + related. COMING SOON products show a waitlist. The form is
// UI only in v1 — wiring to Resend Audiences arrives later in the build order
// (§4), so it does not post anywhere yet.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusDot from '../../components/StatusDot.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import { getPublishedProducts } from '../../lib/content';

export const getStaticPaths = (async () => {
  const products = await getPublishedProducts();
  return products.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const comingSoon = entry.data.stage === 'COMING SOON';
const isPrivateBeta = entry.data.stage === 'PRIVATE BETA';
const showWaitlist = comingSoon || isPrivateBeta;
// Products only: web-lead, when present, splits the page lead -> form -> full
// Content (below the form) instead of the default Content -> form order. Plain
// text, paragraphs separated by a blank line (see content.config.ts).
const leadParagraphs =
  entry.data.lead
    ?.split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean) ?? [];
---

<BaseLayout width="record" title={entry.data.title} description={entry.data.snippet}>
  <article class="product-page">
    <p class="product-page__eyebrow">Deadlink Labs / Products</p>
    <h1 class="product-page__title">{entry.data.title}</h1>
    <div class="product-page__status">
      <StatusDot stage={entry.data.stage} />
    </div>

    {/* Header capture (mirrors the log record's header media, §3): the same
        web-image ProductCard shows at listing size, here at hi-res. Products
        author captures at 1600x1000 (16:10), not 16:9 — the box below matches
        that native ratio rather than force-cropping to the log convention. */}
    {
      entry.data.image && (
        <figure class="product-page__media">
          <Image
            src={entry.data.image}
            alt={`${entry.data.title} UI`}
            format="webp"
            quality={100}
            widths={[480, 720, 960, 1440]}
            sizes="(max-width: 760px) 100vw, 720px"
            loading="eager"
          />
        </figure>
      )
    }

    {
      leadParagraphs.length > 0 ? (
        <>
          {/* web-lead present: lead -> form -> full Content below the form
              (the announcement/pitch continues after the CTA). */}
          <div class="prose">
            {leadParagraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          {showWaitlist && <WaitlistForm isPrivateBeta={isPrivateBeta} />}
          <div class="prose">
            <Content />
          </div>
        </>
      ) : (
        <>
          {/* Default order, unchanged: full Content, then the form. */}
          <div class="prose">
            <Content />
          </div>
          {showWaitlist && <WaitlistForm isPrivateBeta={isPrivateBeta} />}
        </>
      )
    }

    <p class="product-page__back"><a href="/products">← All products</a></p>
  </article>

</BaseLayout>

<style>
  .product-page {
    padding-block: 1rem 1.5rem;
    max-width: 720px;
  }
  .product-page__eyebrow {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
  }
  .product-page__title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .product-page__status {
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  /* Header capture — contained, not full-bleed (§3). Products author at 16:10
     (ProductCard's ratio); logs use 16:9. Both round to the same 4px. */
  .product-page__media {
    margin: 0 0 2rem;
  }
  .product-page__media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
  }

  .prose {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .prose :global(p) {
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }
  /* Ported from log/[slug].astro for parity now that product bodies (Hazefield's
     existing list, this page's new headings) actually use these elements. */
  .prose :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 24px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--color-signal);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-ink-15);
    border-radius: 3px;
    padding: 0.05em 0.35em;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.4rem;
    max-width: 68ch;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin: 0 0 0.5rem;
  }
  .prose :global(li::marker) {
    color: var(--color-ink-60);
  }

  .product-page__back {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink-15);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .product-page__back a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .product-page__back a:hover {
    color: var(--color-signal);
  }
</style>
