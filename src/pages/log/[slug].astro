---
// Log record page (/log/<slug>) — the 8A record template (CLAUDE.md §5.2).
// v1 renders the stamp + question-title + prose body. The fuller template
// (decision register, timeline, series, backlinks) accretes later from
// preserved wikilinks; placeholders keep the reading layout honest.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stamp from '../../components/Stamp.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { getPublishedLog, recordLabel, formatDate } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getPublishedLog();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const label = recordLabel(entry);
---

<BaseLayout width="record" title={entry.data.title} description={entry.data.snippet}>
  <article class="record">
    <div class="record__stamp">
      <Stamp label={label} stage={entry.data.stage} tags={entry.data.tags} />
    </div>
    <h1 class="record__title">{entry.data.title}</h1>
    <p class="record__date">{formatDate(entry.data.pubDate)}</p>
    {/* Header media (§5.2): the video facade when the post has a video (it shows
        the thumbnail with a play button), otherwise the web-thumb as a static
        header. Either way, a post with a thumbnail opens with it. */}
    {
      entry.data.videoId ? (
        <VideoEmbed videoId={entry.data.videoId} thumb={entry.data.thumb} title={entry.data.title} />
      ) : entry.data.thumb ? (
        <figure class="record__media">
          <Image
            src={entry.data.thumb}
            alt=""
            widths={[480, 720, 960, 1440]}
            sizes="(max-width: 760px) 100vw, 720px"
            loading="eager"
          />
        </figure>
      ) : null
    }
    <div class="prose">
      <Content />
    </div>
    <p class="record__back"><a href="/log">← Back to the log</a></p>
  </article>

</BaseLayout>

<style>
  .record {
    padding-block: 1rem 1.5rem;
    max-width: 720px;
  }
  .record__stamp {
    margin-bottom: 1.5rem;
  }
  .record__title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .record__date {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-60);
  }
  /* Header media — a contained specimen at the top of the record, not a
     full-bleed hero (§3). Mirrors the video facade frame. */
  .record__media {
    margin: 0 0 2rem;
  }
  .record__media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
  }
  .record__back {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ink-15);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .record__back a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .record__back a:hover {
    color: var(--color-signal);
  }

  /* Prose — continuous document, measure ~640-720px (§3). */
  .prose {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .prose :global(p) {
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }
  .prose :global(h2) {
    margin: 2.5rem 0 1rem;
    font-size: 24px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--color-signal);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-ink-15);
    border-radius: 3px;
    padding: 0.05em 0.35em;
  }
  .prose :global(pre) {
    background: var(--color-panel);
    color: #d9d4cc;
    padding: 1.25rem 1.4rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 0 0 1.4rem;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }
  /* Inline images (markdown ![]()) — contained, rounded, with a small muted
     italic caption when the next paragraph is all-italic. */
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1.75rem 0 0.6rem;
  }
  .prose :global(p:has(> em:only-child)) {
    margin-top: 0;
    font-size: 13px;
    color: var(--color-ink-60);
  }
  /* Inlined .svg specimen tiles (src/plugins/remark-svg-specimen.mjs). Vector,
     so they stay sharp at any pixel density. Inlining is what lets the tile
     text inherit the page webfont instead of a sandboxed system fallback. */
  .prose :global(.specimen-fig) {
    margin: 1.75rem 0 0.6rem;
  }
  .prose :global(.specimen-fig svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  /* Graphite tiles come out of the inliner with no font-family and inherit the
     page webfont here. An artifact lifted from elsewhere keeps its own type, so
     :not() lets it through — the n8n canvas in LOG 011 mixes Plex Sans titles
     with Plex Mono sublabels, and this rule used to flatten it to all mono. */
  .prose :global(.specimen-fig svg text:not([font-family])) {
    font-family: var(--font-mono);
  }
  /* ```terminal fenced-block -> specimen panel. Re-assert the specimen metrics
     over the generic prose <pre> above (base look lives in global.css). */
  .prose :global(pre.specimen) {
    padding: 1.125rem 1.25rem;
    font-size: 12.5px;
    line-height: 1.85;
    color: #d7d3ca;
  }
  .prose :global(h3) {
    margin: 2rem 0 0.75rem;
    font-size: 20px;
    letter-spacing: -0.015em;
    font-weight: 600;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  /* Tailwind preflight strips list markers globally; prose lists want them back
     (the li::marker rule below styles them). */
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4rem;
    padding-left: 1.4rem;
    max-width: 68ch;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin: 0 0 0.5rem;
  }
  .prose :global(li::marker) {
    color: var(--color-ink-60);
  }
  /* Decision register (§5.2 crown jewel) and any record table. Mono, hairline
     ruled, on the paper — a research log, not a data grid. */
  .prose :global(table) {
    width: 100%;
    max-width: 68ch;
    margin: 0 0 1.4rem;
    border-collapse: collapse;
    font-size: 14px;
  }
  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-60);
    font-weight: 500;
    text-align: left;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 0.9rem 0.6rem 0;
    border-bottom: 1px solid var(--color-ink-15);
    vertical-align: top;
  }
  /* Status token in the last column reads like a stamp. */
  .prose :global(tbody td:last-child) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-60);
    white-space: nowrap;
  }
  /* First column: the DEC / record number, mono like a stamp label. */
  .prose :global(tbody td:first-child) {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-ink-60);
    white-space: nowrap;
  }
  .prose :global(blockquote) {
    margin: 0 0 1.4rem;
    padding: 0.4rem 0 0.4rem 1.2rem;
    border-left: 2px solid var(--color-signal);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--color-ink-60);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  /* Video transcript — native <details> disclosure, zero JS. Collapsed by
     default; the summary reads like a lab-record label. Long-tail SEO text
     that stays out of the way of the reading. */
  .prose :global(details) {
    margin: 2rem 0 1.4rem;
    border-top: 1px solid var(--color-ink-15);
    border-bottom: 1px solid var(--color-ink-15);
  }
  .prose :global(summary) {
    padding: 1rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-60);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .prose :global(summary::-webkit-details-marker) {
    display: none;
  }
  /* Mono +/- affordance in signal orange. */
  .prose :global(summary::before) {
    content: '+';
    color: var(--color-signal);
    font-size: 14px;
    line-height: 1;
  }
  .prose :global(details[open] summary::before) {
    content: '\2212'; /* minus */
  }
  .prose :global(summary:hover) {
    color: var(--color-ink);
  }
  .prose :global(details > *:not(summary)) {
    font-size: 15px;
    color: var(--color-ink-75);
  }
  .prose :global(details > p:first-of-type) {
    margin-top: 0.25rem;
  }
  .prose :global(details > p:last-child) {
    margin-bottom: 1.25rem;
  }
</style>
