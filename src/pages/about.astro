---
// About (/about) — context, not marketing (CLAUDE.md §5.4).
// Deliberately lean: who runs this, the origin of the name, the tools, then the
// off-nav "Work with me" section (the ONE commercial ask). The one ask should
// arrive fast, so there is no Now section (the Log feed IS the now) and no
// résumé section. JSON-LD Person schema lives here and on Home (§2).
// The contact form posts to /api/contact (LOG 002) — a native form POST to the
// site's one on-demand route, which hands the message to Resend. No JavaScript:
// success redirects to /thank-you/, failure to #contact-error below, which a
// :target rule reveals. This page stays fully prerendered either way.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/avatar-2024-mb.jpeg';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcelo Brouard',
  url: 'https://deadlinklabs.com/about',
  jobTitle: 'AI automation and systems builder',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  worksFor: { '@type': 'Organization', name: 'Deadlink Labs' },
};

// What actually gets opened day to day. The build stack (Astro, TypeScript) is
// already stated in the footer colophon, so it is not repeated here.
const tools = ['Obsidian', 'Claude', 'VS Code', 'GitHub', 'Suno', 'Google AI Studio'];
---

<BaseLayout title="About" description="Marcelo Brouard, Buenos Aires. 20+ years turning messy operations into systems that run themselves.">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <article class="about">
    {/* Identity header. "About" drops to the eyebrow and the name becomes the
        H1, with the portrait beside it — the page reads as a person's page
        rather than a filing label. §5.4's beat is intact (who runs this, then
        the origin of the name); its first line just moved out of the prose and
        into the header, where the name is now an H1 on the page that carries
        the Person schema — which is what §2's "Googling Marcelo Brouard must
        find this site" actually wants. The brand token is not lost: the nav
        wordmark sits directly above this on every page. */}
    <header class="about__head">
      <p class="about__eyebrow">About</p>
      <div class="about__id">
        <Image
          class="about__portrait"
          src={avatar}
          alt="Marcelo Brouard"
          width={150}
          height={150}
          densities={[1, 2]}
          loading="eager"
        />
        <div>
          <h1 class="about__title">Marcelo Brouard</h1>
          {/* Dateline, in the record byline's treatment: mono, sentence case,
              12px. Not uppercase — tracking is a caps device, and shouting the
              city under a name would put it in the same class as a stamp. */}
          <p class="about__where">Buenos Aires, Argentina</p>
        </div>
      </div>
    </header>

    {/* The origin of the name (locked beat, §5.4). Opens on the canonical
        positioning line now that the name and city are the header. */}
    <section class="prose about__origin">
      <p>
        20+ years turning messy operations into systems that run themselves: post-production teams,
        pipeline automation, data and dashboards, AI workflows, and the occasional website.
      </p>
      <p>
        When someone asked where they could see the work, there was no link to send. The work was
        real. The URL did not exist. I was the dead link.
      </p>
      <p>
        This lab is the fix. Everything I build now gets documented, numbered, and archived here.
        Nothing 404s anymore.
      </p>
    </section>

    <section class="band">
      <h2 class="band__label">Tools I actually use</h2>
      <ul class="tools">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>

    {/* Work with me — the off-nav consulting home, the ONE ask (§5.4). */}
    <section class="band work" id="work-with-me">
      <h2 class="work__heading">Work with me</h2>
      <div class="prose">
        <p>
          I help small businesses work better with AI and automation. I find what is eating your
          time and money, then I build the fix: automated workflows, dashboards, internal tools, or
          your complete web presence. From understanding the problem to shipping the solution.
        </p>
      </div>
      <ol class="engagement">
        <li><strong>A conversation.</strong> You tell me how the work actually happens today. I ask a lot of questions.</li>
        <li><strong>A plan.</strong> I map what to automate, build, or simplify, with clear scope and a fixed price.</li>
        <li><strong>The build.</strong> I ship, document everything, and hand it over working. You own all of it.</li>
      </ol>
      {/* Proof lives on the homepage band, which carries the thumbnails,
          stamps and snippets — link there rather than duplicate it. */}
      <p class="proof">
        <a href="/#clients">Client work →</a>
      </p>

      {/* Failure state. Revealed by :target when /api/contact redirects here,
          which needs no JavaScript at all. It carries the direct address as
          well, so a visitor whose message did not send still leaves with a way
          to reach me — an error that only apologises is a second dead end. */}
      <div class="contact-error" id="contact-error" role="alert">
        <p class="contact-error__title">That did not send.</p>
        <p>
          Something broke on my end, not yours. Email me directly at
          <a href="mailto:hello@deadlinklabs.com">hello@deadlinklabs.com</a> and I will
          pick it up from there.
        </p>
      </div>

      <form class="contact" method="post" action="/api/contact">
        <div class="contact__field">
          <label class="contact__label" for="c-name">Name</label>
          <input class="contact__input" id="c-name" name="name" type="text" required autocomplete="name" />
        </div>
        {/* Without this the form collected a name and a problem and no way to
            reply. It is also what the endpoint sets as Reply-To. */}
        <div class="contact__field">
          <label class="contact__label" for="c-email">Email</label>
          <input class="contact__input" id="c-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="contact__field">
          <label class="contact__label" for="c-company">Company</label>
          <input class="contact__input" id="c-company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="contact__field">
          <label class="contact__label" for="c-problem">What's eating your time?</label>
          <textarea class="contact__input" id="c-problem" name="problem" rows="4" required></textarea>
        </div>
        <button class="contact__btn" type="submit">Start the conversation</button>
      </form>
    </section>

  </article>
</BaseLayout>

<style>
  .about {
    padding-block: 1rem 0;
    max-width: 720px;
  }
  .about__head {
    margin-bottom: 2.5rem;
  }
  .about__eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
  }
  .about__id {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }
  /* Round, like the record byline and the Home band-06 portrait: the one round
     thing on a site with 0–4px radii, because it is a face (§3). */
  .about__portrait {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
  }
  .about__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-weight: 600;
  }
  .about__where {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-ink-60);
  }

  .prose {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .prose p {
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }
  .prose h2 {
    margin: 2.5rem 0 1rem;
    font-size: 24px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  /* The lede. This used to set the name line; now that the name is the H1, it
     sets the canonical positioning line, which is the better thing to lead on. */
  .about__origin p:first-child {
    font-size: 20px;
    line-height: 1.5;
  }

  .band {
    padding-block: 2rem;
    border-top: 1px solid var(--color-ink-15);
    margin-top: 1.5rem;
  }
  .band__label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
    font-weight: 500;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-60);
    border: 1px solid var(--color-ink-15);
    border-radius: 3px;
    padding: 0.35rem 0.7rem;
  }

  .work__heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .engagement {
    margin: 0 0 1.4rem;
    padding-left: 1.2rem;
    font-size: 18px;
    line-height: 1.6;
  }
  .engagement li {
    margin-bottom: 0.7rem;
    max-width: 68ch;
  }
  .proof {
    font-size: 15px;
    color: var(--color-ink-75);
    margin: 0 0 2rem;
  }
  .proof a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 3px;
  }
  .proof a:hover {
    color: var(--color-signal);
  }

  /* Hidden until /api/contact redirects to /about/#contact-error. Zero JS: the
     browser's own :target does the work, which is why the About page can stay
     fully prerendered while still reporting a server-side failure. */
  .contact-error {
    display: none;
    max-width: 520px;
    margin-bottom: 1.25rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-signal);
    border-radius: 4px;
    font-size: 15px;
    line-height: 1.55;
  }
  .contact-error:target {
    display: block;
  }
  .contact-error p {
    margin: 0;
  }
  .contact-error__title {
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-signal);
  }
  .contact-error a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 3px;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.75rem;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    max-width: 520px;
  }
  .contact__label {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-60);
  }
  .contact__input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 15px;
    background: var(--color-paper);
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    color: var(--color-ink);
  }
  .contact__input:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 1px;
  }
  .contact__btn {
    align-self: flex-start;
    padding: 0.75rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--color-signal);
    border: 1px solid var(--color-signal);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .contact__btn:hover {
    background: #d64300;
  }
  .contact__btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Stack the portrait above the name on a phone. It shrinks with the column:
     a 150px circle beside a clamped-down H1 at 375px leaves the name no room. */
  @media (max-width: 600px) {
    .about__id {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.125rem;
    }
    .about__portrait {
      width: 112px;
      height: 112px;
    }
  }
</style>
