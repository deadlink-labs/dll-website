---
// About (/about) — context, not marketing (CLAUDE.md §5.4).
// Deliberately lean: who runs this, the origin of the name, the tools, then the
// off-nav "Work with me" section (the ONE commercial ask). The one ask should
// arrive fast, so there is no Now section (the Log feed IS the now) and no
// résumé section. JSON-LD Person schema lives here and on Home (§2).
// The contact form below sends through the `contact` action in
// src/actions/index.ts (LOG 002): Resend delivers the message to hello@ and a
// plain-text receipt to the visitor. The form is called from the script at the
// bottom, never from a form `action=` attribute, which is what keeps this page
// prerendered: only the action runs on a server.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/avatar-2024-mb.jpeg';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcelo Brouard',
  url: 'https://deadlinklabs.com/about',
  jobTitle: 'AI automation and systems builder',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  worksFor: { '@type': 'Organization', name: 'Deadlink Labs' },
};

// What actually gets opened day to day. The build stack (Astro, TypeScript) is
// already stated in the footer colophon, so it is not repeated here.
const tools = ['Obsidian', 'Claude', 'VS Code', 'GitHub', 'Suno', 'Google AI Studio'];
---

<BaseLayout title="About" description="Marcelo Brouard, Buenos Aires. 20+ years turning messy operations into systems that run themselves.">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <article class="about">
    {/* Identity header. "About" drops to the eyebrow and the name becomes the
        H1, with the portrait beside it — the page reads as a person's page
        rather than a filing label. §5.4's beat is intact (who runs this, then
        the origin of the name); its first line just moved out of the prose and
        into the header, where the name is now an H1 on the page that carries
        the Person schema — which is what §2's "Googling Marcelo Brouard must
        find this site" actually wants. The brand token is not lost: the nav
        wordmark sits directly above this on every page. */}
    <header class="about__head">
      <p class="about__eyebrow">About</p>
      <div class="about__id">
        <Image
          class="about__portrait"
          src={avatar}
          alt="Marcelo Brouard"
          width={150}
          height={150}
          densities={[1, 2]}
          loading="eager"
        />
        <div>
          <h1 class="about__title">Marcelo Brouard</h1>
          {/* Dateline, in the record byline's treatment: mono, sentence case,
              12px. Not uppercase — tracking is a caps device, and shouting the
              city under a name would put it in the same class as a stamp. */}
          <p class="about__where">Buenos Aires, Argentina</p>
        </div>
      </div>
    </header>

    {/* The origin of the name (locked beat, §5.4). Opens on the canonical
        positioning line now that the name and city are the header. */}
    <section class="prose about__origin">
      <p>
        20+ years turning messy operations into systems that run themselves: post-production teams,
        pipeline automation, data and dashboards, AI workflows, and the occasional website.
      </p>
      <p>
        When someone asked where they could see the work, there was no link to send. The work was
        real. The URL did not exist. I was the dead link.
      </p>
      <p>
        This lab is the fix. Everything I build now gets documented, numbered, and archived here.
        Nothing 404s anymore.
      </p>
    </section>

    <section class="band">
      <h2 class="band__label">Tools I actually use</h2>
      <ul class="tools">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>

    {/* Work with me — the off-nav consulting home, the ONE ask (§5.4). */}
    <section class="band work" id="work-with-me">
      <h2 class="work__heading">Work with me</h2>
      <div class="prose">
        <p>
          I help small businesses work better with AI and automation. I find what is eating your
          time and money, then I build the fix: automated workflows, dashboards, internal tools, or
          your complete web presence. From understanding the problem to shipping the solution.
        </p>
      </div>
      <ol class="engagement">
        <li><strong>A conversation.</strong> You tell me how the work actually happens today. I ask a lot of questions.</li>
        <li><strong>A plan.</strong> I map what to automate, build, or simplify, with clear scope and a fixed price.</li>
        <li><strong>The build.</strong> I ship, document everything, and hand it over working. You own all of it.</li>
      </ol>
      {/* Proof lives on the homepage band, which carries the thumbnails,
          stamps and snippets — link there rather than duplicate it. */}
      <p class="proof">
        <a href="/#clients">Client work →</a>
      </p>

      {/* The `name` attributes are the schema's keys in src/actions/index.ts;
          rename one and its message has no field to land under. `maxlength`
          mirrors the schema so the browser stops a too-long value before the
          request. `novalidate` turns off the browser's own bubbles: the script
          checks each field with the schema's rules and prints the schema's
          words under it instead. `method="post"` and no `action=`: the script
          sends it. */}
      <form class="contact" id="contact-form" method="post" novalidate>
        <div class="contact__field">
          <label class="contact__label" for="c-name">Name</label>
          <input class="contact__input" id="c-name" name="name" type="text" required maxlength="120" autocomplete="name" aria-describedby="c-name-error" />
          <p class="contact__error" id="c-name-error"></p>
        </div>
        {/* Without this the form collected a name and a problem and no way to
            reply. It is the message's Reply-To. */}
        <div class="contact__field">
          <label class="contact__label" for="c-email">Email</label>
          <input class="contact__input" id="c-email" name="email" type="email" required maxlength="200" autocomplete="email" aria-describedby="c-email-error" />
          <p class="contact__error" id="c-email-error"></p>
        </div>
        <div class="contact__field">
          <label class="contact__label" for="c-company">
            Company <span class="contact__optional">(optional)</span>
          </label>
          <input class="contact__input" id="c-company" name="company" type="text" maxlength="160" autocomplete="organization" aria-describedby="c-company-error" />
          <p class="contact__error" id="c-company-error"></p>
        </div>
        {/* The field is `message`, not `problem`: the action is generic so a
            second form can reuse it. The label on screen is the one the
            visitor sees, and it still asks the real question. */}
        <div class="contact__field">
          <label class="contact__label" for="c-message">What's eating your time?</label>
          <textarea class="contact__input" id="c-message" name="message" rows="4" required maxlength="4000" aria-describedby="c-message-error c-message-count"></textarea>
          {/* The message and the count share one line under the box. The
              count is the script's; without it the line reads as a limit. */}
          <div class="contact__meta">
            <p class="contact__error" id="c-message-error"></p>
            <p class="contact__count" id="c-message-count">0 / 4000</p>
          </div>
        </div>
        {/* Which form this is. The action builds the subject line from it. */}
        <input type="hidden" name="source" value="contact" />
        {/* For errors that are not about one field: the send itself failed. */}
        <p class="contact__alert" role="alert"></p>
        <noscript>
          <p class="contact__noscript">
            This form needs JavaScript to send. You can write to
            <a href="mailto:hello@deadlinklabs.com">hello@deadlinklabs.com</a> instead.
          </p>
        </noscript>
        {/* The spinner shows only while the button is `aria-busy`, and not at
            all for a visitor who asked for reduced motion; the label reads
            "Sending" either way. */}
        <button class="contact__btn" type="submit">
          <span class="contact__spinner" aria-hidden="true"></span>
          <span class="contact__btn-label">Start the conversation</span>
        </button>
      </form>

      {/* Takes the form's place once a message is sent. Same card as the
          form. `tabindex="-1"` so the script can move focus here, which is
          how a screen reader learns the form is gone. The receipt line is
          hidden by the script when the copy to the visitor did not go out.
          "Send another message" is the only thing that ever clears the
          fields: it resets the form and brings it back with the cursor in
          the name field. */}
      <div class="contact contact--sent" id="contact-sent" hidden tabindex="-1">
        <p class="contact__label">Sent</p>
        <p class="contact__sent-line">Your message is in my inbox, and I usually get back within a day or two.</p>
        <p class="contact__sent-line" id="contact-receipt">A copy is on its way to the address you gave.</p>
        <button class="contact__again" type="button">Send another message</button>
      </div>
    </section>

  </article>
</BaseLayout>

<script>
  import { actions, isInputError } from 'astro:actions';
  import { LIMIT, MESSAGE, check, type Field } from '../lib/contact-rules';

  // The form calls the contact action from here, not from a form `action=`
  // attribute. A form action would force this page to render on demand;
  // calling it from a script keeps About prerendered, and only the action
  // itself runs on the server.
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const panel = document.querySelector<HTMLElement>('#contact-sent');
  const alert = form?.querySelector<HTMLElement>('.contact__alert');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const btnLabel = button?.querySelector<HTMLElement>('.contact__btn-label');
  const message = form?.querySelector<HTMLTextAreaElement>('#c-message');
  const count = form?.querySelector<HTMLElement>('#c-message-count');
  const receipt = panel?.querySelector<HTMLElement>('#contact-receipt');
  const again = panel?.querySelector<HTMLButtonElement>('.contact__again');

  if (form && panel && alert && button && btnLabel && message && count && receipt && again) {
    // The four fields the visitor types into, in the order they sit on the
    // page. `source` is hidden and has no line to print under.
    const FIELDS: readonly Field[] = ['name', 'email', 'company', 'message'];
    const isField = (name: string): name is Field => (FIELDS as readonly string[]).includes(name);
    const inputOf = (name: Field) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    const errorOf = (name: Field) => document.getElementById(`c-${name}-error`);

    // Print a message under a field, or clear it. The orange border and the
    // screen-reader flag follow the message.
    function show(name: Field, text: string) {
      const line = errorOf(name);
      if (line) line.textContent = text;
      if (text) inputOf(name).setAttribute('aria-invalid', 'true');
      else inputOf(name).removeAttribute('aria-invalid');
    }

    // Run one field through the same rules as the schema, in the schema's
    // words. Email format is the browser's own check, read off `validity`
    // rather than shown in its bubble. True when the field passes.
    function validate(name: Field): boolean {
      const input = inputOf(name);
      const text = check(name, input.value, input.validity.typeMismatch);
      show(name, text);
      return !text;
    }

    for (const name of FIELDS) {
      const input = inputOf(name);
      // Checked as the visitor leaves the field, never while they are still
      // typing in it for the first time.
      input.addEventListener('blur', () => validate(name));
      // Once a field has a message, every keystroke re-checks it, so the
      // message goes away the moment the field is fixed.
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) validate(name);
      });
    }

    // The count under the message box, and the box growing with the text.
    // `rows="4"` is the floor; the CSS `max-height` is the ceiling, past which
    // the box scrolls. The height is measured with the box collapsed first so
    // it can shrink when text is deleted. `scrollHeight` leaves out the
    // border, and the box is `border-box`, so the border is added back.
    const syncMessage = () => {
      count.textContent = `${message.value.length} / ${LIMIT.message}`;
      count.classList.toggle('contact__count--full', message.value.length >= LIMIT.message);
      message.style.height = 'auto';
      message.style.height = `${message.scrollHeight + message.offsetHeight - message.clientHeight}px`;
    };
    message.addEventListener('input', syncMessage);
    syncMessage();

    const idleLabel = btnLabel.textContent;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      alert.textContent = '';

      // Every field, in order. The cursor lands on the first one that fails.
      let firstBad: Field | null = null;
      for (const name of FIELDS) if (!validate(name)) firstBad ??= name;
      if (firstBad) {
        inputOf(firstBad).focus();
        return;
      }

      // While the request is in flight: the label reads "Sending" beside a
      // spinner, the button will not take a second click, and its width is
      // held so the shorter label does not shrink it under the cursor.
      button.style.minWidth = `${button.offsetWidth}px`;
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      btnLabel.textContent = 'Sending';

      try {
        const { data, error } = await actions.contact(new FormData(form));
        if (data) {
          // Sent. The panel takes the form's place. It promises a copy only
          // when the receipt to the visitor actually went out. The fields
          // are left as typed: only "Send another message" clears them.
          receipt.hidden = !data.receipt;
          form.hidden = true;
          panel.hidden = false;
          panel.focus();
        } else if (isInputError(error)) {
          // The server rejected a field. Say which, under that field, and
          // put the cursor on the first one. A rejected `source` has no
          // field on screen, so its message goes to the form-level line.
          let first: Field | null = null;
          for (const [name, messages] of Object.entries(error.fields)) {
            if (!isField(name)) {
              alert.textContent = messages?.[0] ?? MESSAGE.source;
              continue;
            }
            show(name, messages?.[0] ?? '');
            first ??= name;
          }
          if (first) inputOf(first).focus();
        } else {
          // The send failed. The message says so and hands over hello@.
          // Fields stay exactly as typed, and nothing retries on its own:
          // the first attempt may already have landed.
          alert.textContent = error.message;
        }
      } catch {
        // The request never got an answer (offline, connection dropped).
        // `actions.*` does not catch this itself, so without this branch the
        // alert would stay empty. Same rules: fields untouched, no retry.
        alert.textContent =
          'Your message didn’t go through. What you typed is still here. ' +
          'Email me at hello@deadlinklabs.com instead. It reaches the same inbox.';
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.style.minWidth = '';
        btnLabel.textContent = idleLabel;
      }
    });

    // The one place the fields are cleared. The form comes back first so
    // the message box can be measured (a hidden box measures as zero), then
    // it is reset, and the cursor lands in the name field.
    again.addEventListener('click', () => {
      panel.hidden = true;
      form.hidden = false;
      form.reset();
      for (const name of FIELDS) show(name, '');
      alert.textContent = '';
      syncMessage();
      inputOf('name').focus();
    });
  }
</script>

<style>
  .about {
    padding-block: 1rem 0;
    max-width: 720px;
  }
  .about__head {
    margin-bottom: 2.5rem;
  }
  .about__eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
  }
  .about__id {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }
  /* Round, like the record byline and the Home band-06 portrait: the one round
     thing on a site with 0–4px radii, because it is a face (§3). */
  .about__portrait {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
  }
  .about__title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-weight: 600;
  }
  .about__where {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-ink-60);
  }

  .prose {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .prose p {
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }
  .prose h2 {
    margin: 2.5rem 0 1rem;
    font-size: 24px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  /* The lede. This used to set the name line; now that the name is the H1, it
     sets the canonical positioning line, which is the better thing to lead on. */
  .about__origin p:first-child {
    font-size: 20px;
    line-height: 1.5;
  }

  .band {
    padding-block: 2rem;
    border-top: 1px solid var(--color-ink-15);
    margin-top: 1.5rem;
  }
  .band__label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
    font-weight: 500;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-60);
    border: 1px solid var(--color-ink-15);
    border-radius: 3px;
    padding: 0.35rem 0.7rem;
  }

  .work__heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .engagement {
    margin: 0 0 1.4rem;
    padding-left: 1.2rem;
    font-size: 18px;
    line-height: 1.6;
  }
  .engagement li {
    margin-bottom: 0.7rem;
    max-width: 68ch;
  }
  .proof {
    font-size: 15px;
    color: var(--color-ink-75);
    margin: 0 0 2rem;
  }
  .proof a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 3px;
  }
  .proof a:hover {
    color: var(--color-signal);
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.75rem;
    background: var(--color-paper-raised);
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    max-width: 520px;
  }
  /* `display: flex` above would beat the browser's own `[hidden]` rule, so
     the form and the sent panel say it themselves. */
  .contact[hidden] {
    display: none;
  }
  .contact__label {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-60);
  }
  /* The only field that is not required, so it says so. Same mono line, half a
     step quieter, so it reads as a note on the label and not a second label. */
  .contact__optional {
    opacity: 0.62;
  }
  .contact__input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 15px;
    background: var(--color-paper);
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    color: var(--color-ink);
  }
  .contact__input:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 1px;
  }
  /* The message box grows with the text (the script sets its height), so
     the drag handle goes; past the ceiling it scrolls. */
  textarea.contact__input {
    resize: none;
    overflow-y: auto;
    max-height: 24rem;
  }
  /* A field's message and the form-level alert: the labels' mono line, in
     the signal color. `:empty` hides them so an unused line takes no room
     and the form does not shift when one appears. */
  .contact__error,
  .contact__alert {
    margin: 0.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--color-signal);
  }
  .contact__alert {
    margin: 0;
  }
  .contact__error:empty,
  .contact__alert:empty {
    display: none;
  }
  /* Under the message box: the field's message on the left, the count on
     the right. The row carries the top margin so the two lines share it. */
  .contact__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
  }
  .contact__meta .contact__error {
    margin: 0;
  }
  .contact__count {
    margin: 0 0 0 auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink-60);
  }
  .contact__count--full {
    color: var(--color-signal);
  }
  .contact__input[aria-invalid='true'] {
    border-color: var(--color-signal);
  }
  .contact__noscript {
    margin: 0;
    font-size: 15px;
    color: var(--color-ink-75);
  }
  .contact__noscript a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
    text-underline-offset: 3px;
  }
  .contact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    align-self: flex-start;
    padding: 0.75rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--color-signal);
    border: 1px solid var(--color-signal);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .contact__btn:hover {
    background: #d64300;
  }
  .contact__btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  /* While the request is in flight: the label reads "Sending", the button
     will not take a second click, and the cursor says busy. */
  .contact__btn:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .contact__btn:disabled:hover {
    background: var(--color-signal);
  }
  /* A ring in the label's own white, one gap, turning. It exists only while
     the button is busy, and not at all under reduced motion, where the word
     "Sending" does the job on its own. */
  .contact__spinner {
    display: none;
    width: 12px;
    height: 12px;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
  }
  .contact__btn[aria-busy='true'] .contact__spinner {
    display: inline-block;
  }
  @keyframes contact-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes contact-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact__spinner {
      animation: contact-spin 0.8s linear infinite;
    }
    /* Runs each time the panel goes from hidden to shown. */
    .contact--sent {
      animation: contact-fade 0.35s ease-out;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__btn[aria-busy='true'] .contact__spinner {
      display: none;
    }
  }
  /* The sent panel is the same card as the form, with a tighter stack. */
  .contact--sent {
    gap: 0.6rem;
  }
  .contact--sent .contact__label {
    margin-bottom: 0.2rem;
  }
  .contact--sent:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 2px;
  }
  .contact__sent-line {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
