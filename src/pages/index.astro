---
// Home (/) — per the settled Home design (Deadlink-Labs-Home.dc.html) and
// CLAUDE.md §5.1/§6. Band order: Cover · Featured (the bench hero) · Client work ·
// Recent · Products · Throwback · Who runs this · Footer.
//
// Two numbering systems live on this page and they are NOT the same thing.
// "Band N" in the comments below is CLAUDE.md §5.1's band index, which counts the
// masthead (band 2, served by Nav.astro) and the footer; that is why these jump
// from 1 to 3. The rail's 01…06 counts only the labelled bands and is derived at
// build time (see `bands` below). A record number (LOG 001) is a third thing
// again and belongs in a stamp, never in the rail.
// Every band is a 150px mono label column + content; hairline rules divide
// the sheet into bands. The hero, feeds, and products come deterministically
// from site.config.json + published content — composed, not hand-authored.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import StatusDot from '../components/StatusDot.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FeedItem from '../components/FeedItem.astro';
import FeedCard from '../components/FeedCard.astro';
import ProductCard from '../components/ProductCard.astro';
import avatar from '../assets/avatar-2024-mb.jpeg';
import { getHomepageData, recordLabel } from '../lib/content';

const { hero, recent, featuredProducts, clientWork, throwbacks } = await getHomepageData();
const current = hero[0]; // the current experiment on the bench
// "LOG 001" for the hero's eyebrow stamp, or nothing when the post carries no
// web-number (§4 makes it optional). Formatted by the same helper as every other
// stamp on the site. Never invent a number for a record that has none — the
// gutter used to fall back to a decorative "001", which is a lie in a stamp.
const heroRecord = current?.data.number != null ? recordLabel(current) : null;

// The rail's section numbers must stay contiguous whichever bands actually
// render — Products and Throwback vanish with an empty config array. Hard-coded
// numbers drifted the moment one of those flipped: the rail shipped starting at
// 03, with no 01 anywhere on the page. So derive them from the bands that
// render, in render order. Only the Cover is unnumbered; the Featured band leads
// the rail at 01.
const bands = [
  current && 'featured',
  'clients',
  recent.length > 0 && 'recent',
  featuredProducts.length > 0 && 'products',
  throwbacks.length > 0 && 'throwback',
  'who',
].filter(Boolean) as string[];
const bandNum = (id: string) => String(bands.indexOf(id) + 1).padStart(2, '0');

// JSON-LD Person schema — lives on Home and About (§2).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcelo Brouard',
  url: 'https://deadlinklabs.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  worksFor: { '@type': 'Organization', name: 'Deadlink Labs' },
};
---

<BaseLayout flush>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </Fragment>

  {/* Band 1 — Cover. */}
  <Cover />

  {/* Band 3 — Featured: heroPosts[0] rendered as the bench hero, and any further
      heroPosts as rich cards inside the SAME band. One Featured band, one rail
      number — a separate cards band would have carried the same label and its own
      number the moment a second heroPost was added. */}
  {
    current && (
      <section class="band band--hero" id="bench">
        <SectionLabel num={bandNum('featured')} label="Featured" size="lead">
          <span class="hero-status">
            <StatusDot stage={current.data.stage} label={false} />
            <span>{current.data.stage}</span>
          </span>
        </SectionLabel>
        <div>
          <div class="hero">
            <p class="hero__eyebrow">Featured on the bench{heroRecord && ` · ${heroRecord}`}</p>
            <h1 class="hero__question">
              <a class="hero__link" href={`/log/${current.id}`}>{current.data.title}</a>
            </h1>
            {current.data.tags && current.data.tags.length > 0 && (
              <p class="hero__tags">{current.data.tags.join(' / ')}</p>
            )}
            {current.data.snippet && <p class="hero__overview">{current.data.snippet}</p>}
            <pre class="specimen" aria-label="Terminal capture"><code><span class="specimen__dim">$ npm run dev</span>
astro  v5.18.2  ready in 415 ms
┃ Local   <span class="specimen__on">http://localhost:4321/</span>
<span class="specimen__dim">watching for file changes...</span></code></pre>
            <a class="link-under" href={`/log/${current.id}`}>Step into the log →</a>
          </div>
          {hero.length > 1 && (
            <div class="card-grid">
              {hero.slice(1).map((entry) => (
                <FeedCard entry={entry} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* Band 4 — Client work (off-nav consulting surface). Real client proof leads
      BOTH the archive and the coming-soon products (§5.1 order intentionally
      inverted), because this band is the page's proof surface for goals #1 and
      #2 and it was reading as the quietest thing on the page. The emphasis is
      all monochrome: this position, the .band--lead rule and air, and the lede.
      The rows themselves are the SAME component as Throwback's, deliberately.
      The id is the anchor target for the About page's proof link (/#clients);
      global.css gives every [id] scroll-margin so it clears the sticky nav. */}
  <section class="band band--lead" id="clients">
    <SectionLabel num={bandNum('clients')} label="Client work" />
    <div>
      <p class="band-lede">
        Work I built for other businesses. Each one has its own log entry.
      </p>
      <ul class="stamplist">
        {
          clientWork.map((c) => (
            <li class="stamplist__row">
              {c.href ? (
                <a class="stamplist__link" href={c.href}>
                  {c.thumb && (
                    <Image
                      class="stamplist__thumb"
                      src={c.thumb}
                      alt=""
                      widths={[176, 352, 528]}
                      sizes="176px"
                      loading="lazy"
                    />
                  )}
                  <div class="stamplist__text">
                    <div class="stamplist__meta">
                      <span class="stamplist__name">{c.name}</span>
                      {c.record && <span class="stamplist__record">{c.record}</span>}
                      <span class="stamplist__break"></span>
                      <span class="stamplist__note">{c.status}</span>
                      {c.tags && <span class="stamplist__tags">{c.tags.join(' / ')}</span>}
                    </div>
                    {c.title && <span class="stamplist__title">{c.title}</span>}
                    {c.snippet && <p class="stamplist__snippet">{c.snippet}</p>}
                  </div>
                  <span class="stamplist__go" aria-hidden="true">→</span>
                </a>
              ) : (
                <div class="stamplist__text">
                  <div class="stamplist__meta">
                    <span class="stamplist__name">{c.name}</span>
                    <span class="stamplist__note">{c.status}</span>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Band 5 — Recent log entries. */}
  {
    recent.length > 0 && (
      <section class="band">
        <SectionLabel num={bandNum('recent')} label="Recent" />
        <div>
          <p class="band-lede">
            Latest log entries from the lab.
          </p>
          <div class="feed">
            {recent.map((entry) => (
              <FeedItem entry={entry} />
            ))}
          </div>
          <a class="link-under link-under--small" href="/log">All entries →</a>
        </div>
      </section>
    )
  }

  {/* Band 6 — Featured products: one row that scrolls sideways, sized so the
      third card is cut in half at the column edge — the half card is the cue
      that there is more. The arrows are an extra handle on a native scroll
      (trackpad, touch, keyboard all work without them), so they stay hidden
      until the script below has wired them: an arrow that does nothing is a
      faked control. */}
  {
    featuredProducts.length > 0 && (
      <section class="band band--products" id="products">
        <SectionLabel num={bandNum('products')} label="Products" />
        <div class="product-rail">
          <div class="product-track" aria-label="Products">
            {featuredProducts.map((entry) => (
              <ProductCard entry={entry} sizes="(max-width: 600px) 80vw, (max-width: 900px) 60vw, 320px" />
            ))}
          </div>
          <button type="button" class="product-nav__btn product-nav__btn--prev" data-dir="-1" aria-label="Previous product">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <button type="button" class="product-nav__btn product-nav__btn--next" data-dir="1" aria-label="Next product">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
      </section>
    )
  }

  {/* Band 7 — Throwback: projects from before the lab had a URL, written up
      from the archive (§5.2). Deliberately NOT a schedule — a row appears when a
      project gets documented, not on a weekly cadence. Same stamped-list markup
      as the clients band; the Products band (cards, not rows) sits between
      them, so the two lists never read as one. The THROWBACK / NNN label comes
      from the post's own frontmatter, never from site.config.json (§4). */}
  {
    throwbacks.length > 0 && (
      <section class="band" id="throwback">
        <SectionLabel num={bandNum('throwback')} label="Throwback" />
        <div>
          <p class="band-lede">
            Before the lab: Dig through the artifacts that survived.
          </p>
          <ul class="stamplist">
          {throwbacks.map((t) => (
            <li class="stamplist__row">
              <a class="stamplist__link" href={t.href}>
                {t.thumb && (
                  <Image
                    class="stamplist__thumb"
                    src={t.thumb}
                    alt=""
                    widths={[176, 352, 528]}
                    sizes="176px"
                    loading="lazy"
                  />
                )}
                <div class="stamplist__text">
                  <div class="stamplist__meta">
                    <span class="stamplist__name">{t.label}</span>
                    {t.record && <span class="stamplist__record">{t.record}</span>}
                    <span class="stamplist__break"></span>
                    <span class="stamplist__note">{t.status}</span>
                    {t.tags && <span class="stamplist__tags">{t.tags.join(' / ')}</span>}
                  </div>
                  <span class="stamplist__title">{t.title}</span>
                  {t.snippet && <p class="stamplist__snippet">{t.snippet}</p>}
                </div>
                <span class="stamplist__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* Band 8 — Who runs this. The band was answering its own label with text
      alone; the portrait is the answer. It runs at 104px rather than the 28px
      of the record byline because this is the person band, not a byline — at
      byline scale next to an 18px paragraph it reads as a mark, not a face.
      The paragraph itself is the canonical positioning line (§5.1) and is
      untouched: only the layout around it changed.
      The button used to read "See the work →" and point at /log. By the time a
      reader reaches band 06 they have scrolled past five bands of work, so it
      pointed at the one thing they had already done, and it changed the subject
      away from the person the band had just introduced. /about continues this
      exact paragraph and then delivers the beat this band withholds (the dead
      link). Still ONE button — the 2026-08-05 decision against a second CTA
      here holds; this is the same button with an honest destination. */}
  <section class="band band--who">
    <SectionLabel num={bandNum('who')} label="Who runs this" />
    <div class="who">
      <Image
        class="who__portrait"
        src={avatar}
        alt="Marcelo Brouard"
        width={104}
        height={104}
        densities={[1, 2, 3]}
        loading="lazy"
      />
      <div class="who__body">
        <p class="who__text">
          Marcelo Brouard, Buenos Aires. 20+ years turning messy operations into systems that run
          themselves: post-production teams, pipeline automation, data and dashboards, AI workflows,
          and the occasional website.
        </p>
        <div class="who__actions">
          <a class="btn" href="/about">About me →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // The products track scrolls natively; the arrows only page it by one card
  // and dim at either end. Nothing here is needed for the track to work, which
  // is why the arrows stay hidden until this has run.
  const rail = document.querySelector<HTMLElement>('.product-rail');
  const track = rail?.querySelector<HTMLElement>('.product-track');
  const prev = rail?.querySelector<HTMLButtonElement>('.product-nav__btn--prev');
  const next = rail?.querySelector<HTMLButtonElement>('.product-nav__btn--next');
  if (rail && track && prev && next) {
    // Where each card's leading edge sits, as a scroll position, read from
    // the layout so the CSS owns the sizing. The arrows move to the next or
    // previous one of these rather than by a fixed distance: from the
    // clamped end, "one card back" is not a card edge, and on the widths
    // that snap the browser would then yank the track onto one.
    const starts = () => {
      const pad = parseFloat(getComputedStyle(track).paddingLeft);
      const origin = track.getBoundingClientRect().left + track.clientLeft + pad - track.scrollLeft;
      return [...track.children].map((c) => c.getBoundingClientRect().left - origin);
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      rail.dataset.scrollable = String(max > 1);
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };
    // A click glides one step with an ease-out, so it decelerates like a flick
    // instead of the browser's fixed smooth-scroll curve. Snap is suspended
    // for the duration (Chrome re-snaps every programmatic scroll, which
    // would jerk the animation onto a snap point mid-flight) and restored at
    // the landing, which is itself a card edge or the end of the track.
    const easeOut = (t: number) => 1 - (1 - t) ** 3;
    let raf = 0;
    let pending: number | null = null; // where a glide in flight will land
    const glide = (to: number) => {
      cancelAnimationFrame(raf);
      const from = track.scrollLeft;
      const target = Math.max(0, Math.min(track.scrollWidth - track.clientWidth, to));
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        track.scrollTo({ left: target, behavior: 'instant' });
        return;
      }
      pending = target;
      // Inline only; the stylesheet's value comes back when this is cleared,
      // and it is cleared rather than restored so a click that interrupts a
      // glide cannot capture 'none' as the value to put back.
      track.style.scrollSnapType = 'none';
      const t0 = performance.now();
      const frame = (now: number) => {
        const t = Math.min(1, (now - t0) / 650);
        track.scrollTo({ left: from + (target - from) * easeOut(t), behavior: 'instant' });
        if (t < 1) raf = requestAnimationFrame(frame);
        else {
          track.style.scrollSnapType = '';
          pending = null;
        }
      };
      raf = requestAnimationFrame(frame);
    };
    // A click during a glide counts from where that glide will land, so two
    // quick clicks move two cards instead of re-aiming at the same one.
    const go = (dir: number) => {
      const here = pending ?? track.scrollLeft;
      const edges = starts();
      const target =
        dir > 0 ? edges.find((x) => x > here + 1) : edges.reverse().find((x) => x < here - 1);
      if (target !== undefined) glide(target);
    };
    for (const btn of [prev, next]) {
      btn.addEventListener('click', () => go(Number(btn.dataset.dir)));
    }
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
    update();
    rail.dataset.enhanced = '';
  }
</script>

<style>
  /* The stamped-band pattern: 150px mono label column + content (§3). */
  .band {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.125rem var(--gutter, 4rem);
    border-top: 1px solid var(--color-ink-15);
  }
  /* Let grid children shrink so overflow-x content (the terminal) scrolls
     inside its own box instead of stretching the page past the viewport. */
  .band > * {
    min-width: 0;
  }

  .band--hero {
    padding-block: 2.75rem;
  }

  .band--who {
    padding-block: 2.375rem;
  }

  /* The Products band sits on the paper like every other band, with the
     standard top hairline as its divider; the cards render exactly as they do
     on /products (dark screen, ink caption), so no --pc-* overrides here. It
     was the page's one graphite plate until 2026-09-14: lifting the plate but
     keeping the tiles dark was tried first and read as three tall slabs, each
     stretched to the tallest caption, so the dead space showed. Only the extra
     air survives from the dark version. */
  .band--products {
    padding-block: 3rem;
  }

  /* The client band is the page's proof surface (§5.1 band 4), so it opens with
     a chapter-break rule and more air rather than a background. A warm
     --color-surface-2 plate was tried and rejected on sight (2026-08-10):
     Products earns graphite because it showcases screens on a dark surface, but
     a coloured plate mid-sheet just stains the paper. The full-ink rule follows
     Footer.astro, which already uses one to close the page. */
  .band--lead {
    border-top: 1px solid var(--color-ink);
    padding-block: 3rem;
  }

  /* The one band that says in words what it is. Sized at 18px — the same
     paragraph size as .hero__overview and .who__text, so it adds no new step to
     the ladder and never outranks the hero it sits under. Named for the pattern,
     not the band: Throwback and Recent are the other callers. */
  .band-lede {
    margin: 0 0 1.75rem;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-ink-75);
    max-width: 54ch;
  }

  /* Slotted into the Featured band's SectionLabel, so it sits under the rail
     label. Scoped styles still reach it because it is authored here. */
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: -0.35rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-60);
  }

  /* Stack the gutter above content early enough that the catalog feed always
     has room before it collapses (avoids the mid-width title crush). */
  @media (max-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .hero {
    max-width: 720px;
  }

  .hero__eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-60);
  }

  .hero__question {
    margin: 0 0 1.5rem;
    font-size: clamp(2.125rem, 4.6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.022em;
    font-weight: 600;
    color: var(--color-ink);
  }
  /* The hero headline is the biggest thing on the page and pointed at a record,
     so people click it — it just was not a link. Same treatment as every other
     title on this page (.card__title, .stamplist__title): inherits its type, no
     underline at rest, signal orange on hover. The keyboard ring comes from the
     global :focus-visible rule. It duplicates the "Step into the log" link
     below on purpose; both go to the same record, and the headline is the
     target a reader actually aims at. */
  .hero__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .hero__link:hover {
    color: var(--color-signal);
  }

  .hero__tags {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-60);
    font-variant-numeric: tabular-nums;
  }

  .hero__overview {
    margin: 0 0 1.75rem;
    font-size: 18px;
    line-height: 1.6;
    max-width: 600px;
    color: var(--color-ink);
  }

  /* Dark specimen panel styles now live in global.css (shared with the
     ```terminal fenced-block used in posts). */

  /* Underlined mono action link ("Step into the log →", "All entries →"). */
  .link-under {
    display: inline-block;
    white-space: nowrap;
    margin-top: 1.625rem;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .link-under:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }
  .link-under--small {
    margin-top: 1.125rem;
    font-size: 11.5px;
  }

  /* Products track: one row, horizontally scrolled, cut at the column edge so
     the last visible card shows as a half — that half is the "there is more"
     cue, so the fraction is a design constant, not a side effect of the
     viewport. Three tokens size everything: how many cards fill the column
     (--per-view), how many gaps that leaves visible (--gaps), and the gap.
     The gutter stays where every other band keeps it; the track does not
     bleed. The column peaks at 802px, so 2.5 cards means ~305px each.
     The rail is the arrows' anchor and a size container, so the card width
     (and from it the screen's bottom edge, where the arrows sit) can be
     derived in CSS. */
  .product-rail {
    --per-view: 2.5;
    --gaps: 2;
    --track-gap: 1.25rem;
    --card-w: calc((100cqw - var(--gaps) * var(--track-gap)) / var(--per-view));
    position: relative;
    container-type: inline-size;
  }
  /* 4px of padding pulled back with a negative margin: the cards sit exactly
     where the column starts, but the global 2px focus ring (offset 2px) has
     room to draw instead of being clipped by the scroll box. scroll-padding
     keeps the snap aligned to the column, not to the padding edge. */
  .product-track {
    display: flex;
    gap: var(--track-gap);
    padding: 4px;
    margin: -4px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-padding-inline-start: 4px;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  /* No snap on desktop, on purpose: with three cards and 2.5 in view there is
     half a card of travel, so snap points collapse to {start, end} and a
     trackpad swipe either fights back or lurches — it read as stiff. Free
     scroll keeps the trackpad's own inertia; the arrows land on card edges
     by themselves. Snap comes back on touch widths (below), where paging card
     to card is what a swipe is expected to do. */
  .product-track::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .product-track {
      scroll-behavior: smooth;
    }
  }
  .product-track > :global(.product) {
    flex: 0 0 calc((100% - var(--gaps) * var(--track-gap)) / var(--per-view));
  }

  /* The arrows: plain chevrons, the shape every carousel uses, in a paper
     square with the card's own hairline and radius — the same surface and
     tokens as the caption they overlap, so they read as part of the card, not
     a control laid over it. Sat astride the track's two edges and centred on
     the seam between the screen and the caption (the card's 1px border, then
     a 16:10 screen as wide as the card's content box). Centred on the card
     they landed on the status line; on the seam nothing is under them: the
     caption's top padding is 18px, so a 40px button clears the status text by
     2px and stops, horizontally, where the dot begins. Hidden until the script
     has wired them, and hidden again when every card already fits. */
  .product-nav__btn {
    position: absolute;
    top: calc(1px + (var(--card-w) - 2px) * 10 / 16);
    transform: translateY(-50%);
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    background: var(--color-paper);
    color: var(--color-ink-60);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .product-nav__btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .product-rail[data-enhanced][data-scrollable='true'] .product-nav__btn {
    display: flex;
  }
