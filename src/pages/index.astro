---
// Home (/) — design 8A, auto-generated (CLAUDE.md §5.1 / §6).
// Band order: Cover · Masthead · Hero (current experiment) · Featured + Recent
// log · Featured products · Shipped for clients · Who runs this · Footer.
// The hero, feeds, and products come deterministically from site.config.json +
// published content — this page is composed, not hand-authored.
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import Stamp from '../components/Stamp.astro';
import StatusDot from '../components/StatusDot.astro';
import FeedItem from '../components/FeedItem.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import { getHomepageData, recordLabel } from '../lib/content';

const { hero, recent, featuredProducts } = await getHomepageData();
const current = hero[0]; // the current experiment on the bench

// Client work surfaced off-nav (§5.1 band 6). Placeholder stand-ins.
const clientWork = [
  { name: 'Uruguay Outfitters', note: 'SHIPPED · 2026' },
  { name: 'Crehana', note: 'CASE STUDY' },
];

// JSON-LD Person schema — lives on Home and About (§2).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcelo Brouard',
  url: 'https://deadlinklabs.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  worksFor: { '@type': 'Organization', name: 'Deadlink Labs' },
};
---

<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <Cover slot="cover" />

  {/* Band 3 — Hero: the current experiment's question. */}
  {
    current && (
      <section class="hero" id="bench">
        <p class="hero__eyebrow">
          <StatusDot stage="IN PROGRESS" label={false} />
          <span>Currently on the bench · {recordLabel(current)}</span>
        </p>
        <h1 class="hero__question">{current.data.title}</h1>
        <div class="hero__stamp">
          <Stamp label={recordLabel(current)} stage={current.data.stage} tags={current.data.tags} />
        </div>
        {current.data.snippet && <p class="hero__overview">{current.data.snippet}</p>}
        <pre class="specimen" aria-label="Terminal capture"><code>$ tail -f lab.log
[07:14:02] build ok — 0 errors, zero JS shipped
[07:14:02] cover mark resolved · live node online
[07:14:03] waiting for the next decision…</code></pre>
        <a class="hero__more" href={`/log/${current.id}`}>Step into the log →</a>
      </section>
    )
  }

  {/* Band 4 — Featured then recent log entries. */}
  {
    hero.length > 0 && (
      <section class="band" id="featured">
        <h2 class="band__label">Featured</h2>
        <div class="feed">
          {hero.map((entry) => (
            <FeedItem entry={entry} />
          ))}
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="band">
        <h2 class="band__label">Recent</h2>
        <div class="feed">
          {recent.map((entry) => (
            <FeedItem entry={entry} />
          ))}
        </div>
        <a class="band__more" href="/log">All entries →</a>
      </section>
    )
  }

  {/* Band 5 — Featured products. */}
  {
    featuredProducts.length > 0 && (
      <section class="band" id="products">
        <h2 class="band__label">Products</h2>
        <div class="product-grid">
          {featuredProducts.map((entry) => (
            <ProductCard entry={entry} />
          ))}
        </div>
      </section>
    )
  }

  {/* Band 6 — Shipped for clients (off-nav consulting surface). */}
  <section class="band">
    <h2 class="band__label">Shipped for clients</h2>
    <ul class="clients">
      {
        clientWork.map((c) => (
          <li class="clients__row">
            <span class="clients__name">{c.name}</span>
            <span class="clients__note">{c.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Band 7 — Who runs this. */}
  <section class="band who">
    <h2 class="band__label">Who runs this</h2>
    <p class="who__text">
      Marcelo Brouard, Buenos Aires. Thirty years turning messy operations into systems that run
      themselves — post-production, AI automation, dashboards, and the occasional website.
    </p>
    <div class="who__actions">
      <a class="btn" href="/log">See the work →</a>
      <a class="btn btn--signal" href="/about#work-with-me">Work with me</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-block: 1rem 2.5rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-signal);
  }

  .hero__question {
    margin: 0 0 1.4rem;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    font-weight: 600;
    max-width: 18ch;
  }

  .hero__stamp {
    margin-bottom: 1.4rem;
  }

  .hero__overview {
    margin: 0 0 1.8rem;
    font-size: 17px;
    line-height: 1.65;
    max-width: 68ch;
    color: var(--color-ink);
  }

  /* Dark specimen panel — a specimen in the notebook (§3). */
  .specimen {
    margin: 0 0 1.8rem;
    padding: 1.25rem 1.4rem;
    background: var(--color-panel);
    border-radius: 4px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: #d9d4cc;
  }
  .specimen code {
    font-family: inherit;
    white-space: pre;
  }

  .hero__more {
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-signal);
    padding-bottom: 2px;
  }
  .hero__more:hover {
    color: var(--color-signal);
  }

  .band {
    padding-block: 2.25rem;
    border-top: 1px solid var(--color-ink-15);
  }

  .band__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-60);
    font-weight: 500;
  }

  .band__more {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-signal);
    padding-bottom: 2px;
  }
  .band__more:hover {
    color: var(--color-signal);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .clients {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .clients__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-ink-15);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
  }
  .clients__name {
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .clients__note {
    color: var(--color-ink-60);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .who__text {
    margin: 0.75rem 0 1.5rem;
    font-size: 17px;
    line-height: 1.65;
    max-width: 68ch;
  }
  .who__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--color-ink-15);
    border-radius: 4px;
    color: var(--color-ink);
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .btn:hover {
    border-color: var(--color-ink);
  }
  .btn--signal {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: #fff;
  }
  .btn--signal:hover {
    background: #d64300;
    border-color: #d64300;
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }
</style>
