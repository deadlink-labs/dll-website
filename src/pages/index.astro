---
// Home (/) — per the settled Home design (Deadlink-Labs-Home.dc.html) and
// CLAUDE.md §5.1/§6. Band order: Cover · On the bench (hero) · Featured ·
// Recent · Shipped for clients · Products · Throwback · Who runs this · Footer.
// Every band is a 150px mono label column + content; hairline rules divide
// the sheet into bands. The hero, feeds, and products come deterministically
// from site.config.json + published content — composed, not hand-authored.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import StatusDot from '../components/StatusDot.astro';
import SectionLabel from '../components/SectionLabel.astro';
import FeedItem from '../components/FeedItem.astro';
import FeedCard from '../components/FeedCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { getHomepageData } from '../lib/content';

const { hero, recent, featuredProducts, clientWork, throwbacks } = await getHomepageData();
const current = hero[0]; // the current experiment on the bench
// Oversized record number for the hero gutter (model-number treatment).
const heroNum = current?.data.number != null ? String(current.data.number).padStart(3, '0') : '001';

// JSON-LD Person schema — lives on Home and About (§2).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcelo Brouard',
  url: 'https://deadlinklabs.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  worksFor: { '@type': 'Organization', name: 'Deadlink Labs' },
};
---

<BaseLayout flush>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </Fragment>

  {/* Band 1 — Cover. */}
  <Cover />

  {/* Band 2 — Hero: the current experiment's question. */}
  {
    current && (
      <section class="band band--hero" id="bench">
        <div class="hero-index">
          <span class="hero-index__kind">LOG</span>
          <span class="hero-index__num">{heroNum}</span>
          <span class="hero-index__status">
            <StatusDot stage={current.data.stage} label={false} />
            <span>{current.data.stage}</span>
          </span>
        </div>
        <div class="hero">
          <p class="hero__eyebrow">Currently on the bench</p>
          <h1 class="hero__question">{current.data.title}</h1>
          {current.data.tags && current.data.tags.length > 0 && (
            <p class="hero__tags">{current.data.tags.join(' / ')}</p>
          )}
          {current.data.snippet && <p class="hero__overview">{current.data.snippet}</p>}
          <pre class="specimen" aria-label="Terminal capture"><code><span class="specimen__dim">$ npm run dev</span>
astro  v5.18.2  ready in 415 ms
┃ Local   <span class="specimen__on">http://localhost:4321/</span>
<span class="specimen__dim">watching for file changes...</span></code></pre>
          <a class="link-under" href={`/log/${current.id}`}>Step into the log →</a>
        </div>
      </section>
    )
  }

  {/* Band 3 — Featured then recent log entries. */}
  {
    hero.length > 1 && (
      <section class="band" id="featured">
        <SectionLabel num="02" label="Featured" />
        {/* Rich cards (thumbnail + snippet) — the inviting top of the archive
            (§5.1). heroPosts[0] is already the bench hero above, so the Featured
            band renders the REST (hero.slice(1)) to avoid showing it twice. */}
        <div class="card-grid">
          {hero.slice(1).map((entry) => (
            <FeedCard entry={entry} />
          ))}
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="band">
        <SectionLabel num="03" label="Recent" />
        <div>
          <div class="feed">
            {recent.map((entry) => (
              <FeedItem entry={entry} />
            ))}
          </div>
          <a class="link-under link-under--small" href="/log">All entries →</a>
        </div>
      </section>
    )
  }

  {/* Band 4 — Shipped for clients (off-nav consulting surface). Real shipped
      proof leads coming-soon products (§5.1 order intentionally inverted).
      The id is the anchor target for the About page's proof link (/#clients);
      global.css gives every [id] scroll-margin so it clears the sticky nav. */}
  <section class="band" id="clients">
    <SectionLabel num="04" label="Shipped for clients" />
    <ul class="stamplist">
      {
        clientWork.map((c) => (
          <li class="stamplist__row">
            {c.href ? (
              <a class="stamplist__link" href={c.href}>
                {c.thumb && (
                  <Image
                    class="stamplist__thumb"
                    src={c.thumb}
                    alt=""
                    widths={[176, 352, 528]}
                    sizes="176px"
                    loading="lazy"
                  />
                )}
                <div class="stamplist__text">
                  <div class="stamplist__meta">
                    <span class="stamplist__name">{c.name}</span>
                    {c.record && <span class="stamplist__record">{c.record}</span>}
                    <span class="stamplist__note">{c.status}</span>
                  </div>
                  {c.title && <span class="stamplist__title">{c.title}</span>}
                  {c.snippet && <p class="stamplist__snippet">{c.snippet}</p>}
                </div>
                <span class="stamplist__go" aria-hidden="true">→</span>
              </a>
            ) : (
              <div class="stamplist__text">
                <div class="stamplist__meta">
                  <span class="stamplist__name">{c.name}</span>
                  <span class="stamplist__note">{c.status}</span>
                </div>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  {/* Band 5 — Featured products. */}
  {
    featuredProducts.length > 0 && (
      <section class="band band--dark" id="products">
        <SectionLabel num="05" label="Products" tone="dark" />
        <div class="product-grid">
          {featuredProducts.map((entry) => (
            <ProductCard entry={entry} />
          ))}
        </div>
      </section>
    )
  }

  {/* Band 6 — Throwback: projects from before the lab had a URL, written up
      from the archive (§5.2). Deliberately NOT a schedule — a row appears when a
      project gets documented, not on a weekly cadence. Same stamped-list markup
      as the clients band; the dark Products band sits between them, so the two
      lists never read as one. The THROWBACK / NNN label comes from the post's
      own frontmatter, never from site.config.json (§4). */}
  {
    throwbacks.length > 0 && (
      <section class="band" id="throwback">
        <SectionLabel num="06" label="Throwback" />
        <ul class="stamplist">
          {throwbacks.map((t) => (
            <li class="stamplist__row">
              <a class="stamplist__link" href={t.href}>
                {t.thumb && (
                  <Image
                    class="stamplist__thumb"
                    src={t.thumb}
                    alt=""
                    widths={[176, 352, 528]}
                    sizes="176px"
                    loading="lazy"
                  />
                )}
                <div class="stamplist__text">
                  <div class="stamplist__meta">
                    <span class="stamplist__name">{t.label}</span>
                    {t.record && <span class="stamplist__record">{t.record}</span>}
                    <span class="stamplist__note">{t.status}</span>
                  </div>
                  <span class="stamplist__title">{t.title}</span>
                  {t.snippet && <p class="stamplist__snippet">{t.snippet}</p>}
                </div>
                <span class="stamplist__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Band 7 — Who runs this. */}
  <section class="band band--who">
    <SectionLabel num="07" label="Who runs this" />
    <div class="who">
      <p class="who__text">
        Marcelo Brouard, Buenos Aires. 20+ years turning messy operations into systems that run
        themselves: post-production teams, pipeline automation, data and dashboards, AI workflows,
        and the occasional website.
      </p>
      <div class="who__actions">
        <a class="btn" href="/log">See the work →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The stamped-band pattern: 150px mono label column + content (§3). */
  .band {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2.125rem var(--gutter, 4rem);
    border-top: 1px solid var(--color-ink-15);
  }
  /* Let grid children shrink so overflow-x content (the terminal) scrolls
     inside its own box instead of stretching the page past the viewport. */
  .band > * {
    min-width: 0;
  }

  .band--hero {
    padding-block: 2.75rem;
  }

  .band--who {
    padding-block: 2.375rem;
  }

  /* The one dark showcase beat: the Products band on warm graphite. The tonal
     shift is the divider, so no top hairline. Product tiles are recessed
     screens; the caption text flips light via the --pc-* custom properties. */
  .band--dark {
    background: var(--color-panel);
    border-top: none;
    padding-block: 3rem;
    --pc-line: var(--color-on-panel-15);
    --pc-line-strong: var(--color-on-panel);
    --pc-fg: var(--color-on-panel);
    --pc-fg-60: var(--color-on-panel-60);
    --token-fg: var(--color-on-panel-60);
  }

  /* Hero gutter: the live experiment rendered as an oversized model number. */
  .hero-index {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding-top: 4px;
    font-family: var(--font-mono);
  }
  .hero-index__kind {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink-60);
  }
  .hero-index__num {
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .hero-index__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.35rem;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-60);
  }

  /* Stack the gutter above content early enough that the catalog feed always
     has room before it collapses (avoids the mid-width title crush). */
  @media (max-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .hero {
    max-width: 720px;
  }

  .hero__eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-60);
  }

  .hero__question {
    margin: 0 0 1.5rem;
    font-size: clamp(2.125rem, 4.6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.022em;
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__tags {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-60);
    font-variant-numeric: tabular-nums;
  }

  .hero__overview {
    margin: 0 0 1.75rem;
    font-size: 18px;
    line-height: 1.6;
    max-width: 600px;
    color: var(--color-ink);
  }

  /* Dark specimen panel styles now live in global.css (shared with the
     ```terminal fenced-block used in posts). */

  /* Underlined mono action link ("Step into the log →", "All entries →"). */
  .link-under {
    display: inline-block;
    white-space: nowrap;
    margin-top: 1.625rem;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .link-under:hover {
    color: var(--color-signal);
    border-bottom-color: var(--color-signal);
  }
  .link-under--small {
    margin-top: 1.125rem;
    font-size: 11.5px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  /* Featured cards, stacked with a hairline between — bands within the sheet,
     not gaps between boxes (§3). */
  .card-grid {
    display: flex;
    flex-direction: column;
  }
  .card-grid > :global(* + *) {
    border-top: 1px solid var(--color-ink-08);
  }

  /* Stamped list — the shared row treatment behind BOTH the "Shipped for
     clients" band and the "Throwback" band: 176px thumb, a mono eyebrow built
     out of stamp fields, a sans title, a snippet. Named for the pattern rather
     than for either band, because it now has two callers. */
  .stamplist {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stamplist__row {
    border-bottom: 1px solid var(--color-ink-08);
  }
  /* Linked rows (client work with a case-study post) fill the row and link out. */
  .stamplist__link {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding-block: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  /* Case-study thumbnail — a splash of image anchoring the proof row. */
  .stamplist__thumb {
    width: 176px;
    height: 99px;
    object-fit: cover;
    border-radius: 4px;
    flex: none;
  }
  /* Text column grows to fill; min-width:0 lets the snippet wrap cleanly. */
  .stamplist__text {
    flex: 1;
    min-width: 0;
    padding-block: 1.5rem;
  }
  .stamplist__link .stamplist__text {
    padding-block: 0;
  }
  /* Eyebrow: client name + status token, mono chrome above the title. */
  .stamplist__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }
  /* Middot separators between eyebrow fields, matching the lab-record stamp
     (§3: "LOG 012 · IN PROGRESS · …") and the dot already inside the status. */
  .stamplist__record::before,
  .stamplist__note::before {
    content: "·";
    margin: 0 0.5em;
    color: var(--color-ink-60);
    font-weight: 400;
  }
  .stamplist__name {
    font-size: 12px;
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  /* Record stamp — same treatment as the feed's LOG number, so the client band
     reads as part of the one stamp system (§3). */
  .stamplist__record {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0.08em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .stamplist__note {
    font-size: 11px;
    color: var(--color-ink-60);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* Descriptive case-study title — sentence-case sans, consistent with the feed. */
  .stamplist__title {
    display: block;
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.011em;
    color: var(--color-ink);
    transition: color 0.18s ease;
  }
  .stamplist__snippet {
    margin: 0.4rem 0 0;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-60);
    max-width: 62ch;
  }
  .stamplist__link:hover .stamplist__title {
    color: var(--color-signal);
  }
  .stamplist__go {
    flex: none;
    align-self: center;
    color: var(--color-signal);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .stamplist__link:hover .stamplist__go {
    opacity: 1;
  }
  @media (max-width: 600px) {
    .stamplist__link {
      flex-wrap: wrap;
      gap: 0.875rem;
    }
    .stamplist__thumb {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
    .stamplist__go {
      display: none;
    }
  }

  .who {
    max-width: 600px;
  }
  .who__text {
    margin: 0 0 1.625rem;
    font-size: 18px;
    line-height: 1.6;
  }
  .who__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    padding: 11px 18px;
    border: 1px solid var(--color-ink-15);
    border-radius: 3px;
    color: var(--color-ink);
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .btn:hover {
    border-color: var(--color-ink);
  }
  .btn--signal {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: #fff;
  }
  .btn--signal:hover {
    background: #d64300;
    border-color: #d64300;
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }
</style>
