---
// FeedItem — one row in a log feed, per the settled Home design
// (Deadlink-Labs-Home.dc.html): status dot + number, title, date, separated
// by faint hairline rules (drawn on the row, not via gaps between cards).
import StatusDot from './StatusDot.astro';
import { formatDate, recordLabel, type LogEntry } from '../lib/content';

interface Props {
  entry: LogEntry;
}
const { entry } = Astro.props;
const label = recordLabel(entry);
---

<a class="feed-item" href={`/log/${entry.id}`}>
  <span class="feed-item__meta">
    <StatusDot stage={entry.data.stage} label={false} />
    <span class="feed-item__num">{label}</span>
  </span>
  <span class="feed-item__title">{entry.data.title}</span>
  <time class="feed-item__date" datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
</a>

<style>
  .feed-item {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-ink-08);
    text-decoration: none;
    color: inherit;
  }

  .feed-item:hover .feed-item__title {
    color: var(--color-signal);
  }

  .feed-item__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-ink-60);
  }

  .feed-item__title {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .feed-item__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-ink-60);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .feed-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .feed-item__date {
      order: 3;
    }
  }
</style>
