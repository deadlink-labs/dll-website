---
// FeedItem — one row in a log feed, as a catalog / spec-sheet line
// (Teenage-Engineering register). Columns: record number, status, title,
// date, and a hover chevron. Numbers and dates are tabular so the columns
// read like an instrument printout; the row tints with the second tone and
// the chevron slides in on hover.
import StatusDot from './StatusDot.astro';
import { formatDate, recordLabel, type LogEntry } from '../lib/content';

interface Props {
  entry: LogEntry;
}
const { entry } = Astro.props;
const label = recordLabel(entry);
const stage = entry.data.stage;
---

<a class="feed-item" href={`/log/${entry.id}`}>
  <span class="feed-item__num">{label}</span>
  <span class="feed-item__status">
    <StatusDot stage={stage} label={false} />
    {stage && <span class="feed-item__stage">{stage}</span>}
  </span>
  <span class="feed-item__title">{entry.data.title}</span>
  <time class="feed-item__date" datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
  <span class="feed-item__go" aria-hidden="true">→</span>
</a>

<style>
  .feed-item {
    display: grid;
    grid-template-columns: 66px 116px 1fr auto 16px;
    align-items: baseline;
    gap: 0.4rem 1.25rem;
    padding-block: 0.85rem;
    /* bleed the hover tint a touch past the text on both sides */
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
    border-bottom: 1px solid var(--color-ink-08);
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
  }

  .feed-item:hover {
    background: var(--color-surface-2);
  }
  .feed-item:hover .feed-item__title {
    color: var(--color-signal);
  }
  .feed-item:hover .feed-item__go {
    opacity: 1;
    transform: translateX(0);
  }

  .feed-item__num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .feed-item__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-60);
  }

  .feed-item__title {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color 0.18s ease;
  }

  .feed-item__date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-ink-60);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .feed-item__go {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-signal);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  @media (max-width: 680px) {
    .feed-item {
      grid-template-columns: auto 1fr;
      gap: 0.3rem 1rem;
    }
    .feed-item__title {
      grid-column: 1 / -1;
      order: 3;
    }
    .feed-item__date {
      order: 2;
      text-align: right;
    }
    .feed-item__go {
      display: none;
    }
  }
</style>
