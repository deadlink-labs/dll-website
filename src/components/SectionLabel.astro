---
// SectionLabel — the numbered instrument gutter for a band (the left rail).
// A precise index in the instrument register: a tabular section number, a
// hairline tick, then the label in small letter-spaced mono. Turns the 150px
// label column into a spec-sheet gutter instead of a lone word.
// `tone="dark"` flips the colors for bands that sit on graphite.
// The number here is a SECTION index (where you are on the page), never a record
// number (which post this is) — a record number belongs in the stamp. The rail
// carried both for a while and read as two numbering systems in one gutter.
// Anything slotted in renders under the label, for a band that needs one more
// line in its gutter (the lead band's status token).
interface Props {
  /** Zero-padded section index, e.g. "02". */
  num: string;
  /** The band label, e.g. "Featured". */
  label: string;
  /** "dark" when the band background is graphite. */
  tone?: 'light' | 'dark';
  /** "lead" renders the number one step up, for the band that opens the page. */
  size?: 'default' | 'lead';
}
const { num, label, tone = 'light', size = 'default' } = Astro.props;
---

<div
  class:list={[
    'section-label',
    { 'section-label--dark': tone === 'dark', 'section-label--lead': size === 'lead' },
  ]}
>
  <span class="section-label__num">{num}</span>
  <span class="section-label__tick" aria-hidden="true"></span>
  <h2 class="section-label__label">{label}</h2>
  <slot />
</div>

<style>
  .section-label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding-top: 2px;
    font-family: var(--font-mono);
  }

  /* Architectural section number — every band, dark or light, holds equal
     structural weight in the rail. The one exception is --lead, below. */
  .section-label__num {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .section-label__tick {
    width: 20px;
    height: 1px;
    background: var(--color-ink-15);
  }

  .section-label__label {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-60);
    line-height: 1.3;
  }

  /* The lead band's number runs one step up — a deliberate hierarchy for the
     band that opens the page, not drift. Everything else about the rail is
     identical, which is the whole point of it being the same component. */
  .section-label--lead .section-label__num {
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  /* On graphite bands. */
  .section-label--dark .section-label__num {
    color: var(--color-on-panel);
  }
  .section-label--dark .section-label__tick {
    background: var(--color-on-panel-15);
  }
  .section-label--dark .section-label__label {
    color: var(--color-on-panel-60);
  }
</style>
