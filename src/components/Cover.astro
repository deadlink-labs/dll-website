---
// Cover — the homepage title band, per the settled Home design
// (Deadlink-Labs-Home.dc.html). The first band inside the sheet: the network
// mark centered in negative space, the brand + tagline in Plex Mono below.
// The lab identity stays; a short line gives a new visitor the work context.
import NetworkMark from './NetworkMark.astro';
---

<section class="cover">
  <div class="cover__stage">
    <NetworkMark />
  </div>
  <p class="cover__brand">Deadlink Labs</p>
  <p class="cover__tagline">Build to Understand.</p>
  <p class="cover__context">AI operations and workflow automation.<br />Built by Marcelo Brouard, documented here.</p>
  <a class="cover__work" href="/about#work-with-me">Work with me →</a>
</section>

<style>
  .cover__context {
    margin: 0;
    max-width: 40ch;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-ink-75);
  }
  .cover__work {
    color: var(--color-ink);
    text-underline-offset: 4px;
  }
  /* A title-page composition: a large mark in a generous, composed field. */
  .cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(3rem, 8vw, 6rem) var(--gutter, 4rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .cover__stage {
    width: min(520px, 82vw);
  }

  .cover__brand {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    /* offset the trailing letter-spacing so the word reads optically centered */
    padding-left: 0.34em;
    color: var(--color-ink);
  }

  .cover__tagline {
    margin: -12px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    padding-left: 0.16em;
    color: var(--color-ink-60);
  }
</style>
