---
// Cover — the homepage title band, per the settled Home design
// (Deadlink-Labs-Home.dc.html). The first band inside the sheet: the network
// mark centered in negative space, the brand + tagline in Plex Mono below.
// No hero marketing, no welcome copy, no CTA.
import NetworkMark from './NetworkMark.astro';
---

<section class="cover">
  <div class="cover__stage">
    <NetworkMark />
  </div>
  <p class="cover__brand">Deadlink Labs</p>
  <p class="cover__tagline">Build to Understand.</p>
</section>

<style>
  .cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    padding: clamp(1.25rem, 3vw, 2rem) var(--gutter, 4rem) clamp(2.5rem, 5vw, 3.25rem);
  }

  .cover__stage {
    width: min(360px, 100%);
  }

  .cover__brand {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    /* offset the trailing letter-spacing so the word reads optically centered */
    padding-left: 0.34em;
    color: var(--color-ink);
  }

  .cover__tagline {
    margin: -12px 0 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    padding-left: 0.16em;
    color: var(--color-ink-60);
  }
</style>
