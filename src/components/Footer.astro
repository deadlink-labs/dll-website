---
// Footer / colophon — per the settled Home design (Deadlink-Labs-Home.dc.html).
// Manifesto line, then channels + colophon on one row. Rendered by BaseLayout
// as the sheet's closing band on every page. Contact + social hrefs are
// PLACEHOLDERS — confirm the real addresses before launch.
// (The design shows the colophon in ink-15; that fails the AA contrast floor
// for text, so it renders in ink-60 here.)
const stamp = new Intl.DateTimeFormat('en-US', { month: '2-digit', year: 'numeric' })
  .format(new Date())
  .replace('/', '.');

const channels = [
  { label: 'Email', href: 'mailto:hello@deadlinklabs.com' },
  { label: 'YouTube', href: 'https://youtube.com/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'GitHub', href: 'https://github.com/deadlink-labs' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="colophon">
  <p class="colophon__manifesto">
    Build to understand · Document to remember · Share so others can build further
  </p>
  <div class="colophon__row">
    <ul class="colophon__channels">
      {
        channels.map((c) => (
          <li>
            <a href={c.href} class="colophon__link">
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="colophon__set">Set in IBM Plex · Built with Astro · Last updated {stamp}</p>
  </div>
</footer>

<style>
  .colophon {
    border-top: 1px solid var(--color-ink);
    padding: 2.75rem var(--gutter, 4rem) 2.5rem;
    font-family: var(--font-mono);
  }

  .colophon__manifesto {
    margin: 0 0 1.75rem;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink);
  }

  .colophon__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
  }

  .colophon__channels {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .colophon__link {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-60);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .colophon__link:hover {
    color: var(--color-signal);
  }
  .colophon__link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  .colophon__set {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-ink-60);
  }
</style>
