---
// Footer / colophon — per the settled Home design (Deadlink-Labs-Home.dc.html).
// Manifesto line, then channels + colophon on one row. Rendered by BaseLayout
// as the sheet's closing band on every page.
// (The design shows the colophon in ink-15; that fails the AA contrast floor
// for text, so it renders in ink-60 here.)
const stamp = new Intl.DateTimeFormat('en-US', { month: '2-digit', year: 'numeric' })
  .format(new Date())
  .replace('/', '.');

// A channel without an href renders as plain text, not a link — the channel is
// named but has nowhere to point yet. Better than a link to a bare root URL.
// NOTE: hello@deadlinklabs.com is still unconfirmed; the rest are real.
interface Channel {
  label: string;
  href?: string;
}

const channels: Channel[] = [
  { label: 'Email', href: 'mailto:hello@deadlinklabs.com' },
  { label: 'YouTube' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mbrouard/' },
  { label: 'GitHub', href: 'https://github.com/deadlink-labs' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="colophon">
  <p class="colophon__invite">
    <a href="/about#work-with-me">Let's make something together <span class="colophon__arrow" aria-hidden="true">→</span></a>
  </p>
  <p class="colophon__manifesto">
    Build to understand · Document to remember · Share so others can build further
  </p>
  <div class="colophon__row">
    <ul class="colophon__channels">
      {
        channels.map((c) => (
          <li>
            {c.href ? (
              <a href={c.href} class="colophon__link">
                {c.label}
              </a>
            ) : (
              <span class="colophon__link colophon__link--plain">{c.label}</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="colophon__set">Astro · IBM Plex · Vercel · Updated {stamp}</p>
  </div>
</footer>

<style>
  .colophon {
    border-top: 1px solid var(--color-ink);
    padding: 2.75rem var(--gutter, 4rem) 2.5rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .colophon__manifesto {
    margin: 0 0 1.75rem;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink);
  }

  /* Warm invitation — leads the footer, sentence case among the uppercase mono
     chrome so it reads human. A signal, not a CTA button (§1 / recruiter goal). */
  /* Orange invitation. At 24px it clears WCAG AA as large text (3:1); signal
     orange on paper is ~3.4:1, which would FAIL for normal-size text (4.5:1) —
     the size is load-bearing for accessibility, not just emphasis. */
  .colophon__invite {
    margin: 0 0 1.5rem;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
  }
  .colophon__invite a {
    color: var(--color-signal);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .colophon__invite a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .colophon__invite a:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }
  .colophon__arrow {
    color: var(--color-signal);
  }

  .colophon__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.25rem;
  }

  .colophon__channels {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .colophon__link {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-60);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .colophon__link:hover {
    color: var(--color-signal);
  }
  .colophon__link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  /* Named but unlinked (see the channels array). Shares the type treatment so
     the row stays even, but must not imply it is clickable — the base class's
     :hover would otherwise turn it orange on a <span>. */
  .colophon__link--plain:hover {
    color: var(--color-ink-60);
  }

  .colophon__set {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-ink-60);
  }
</style>
