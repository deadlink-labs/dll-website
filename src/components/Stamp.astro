---
// Stamp — the lab-record metadata block (CLAUDE.md §3).
// Every content record opens with this: monospace, uppercase, letter-spaced,
// ink-60, with the status token carried by StatusDot (orange when active).
//   LOG 012 · IN PROGRESS · TESTING · LOCAL-LLM / HOME-ASSISTANT / PYTHON
import StatusDot from './StatusDot.astro';

interface Props {
  /** Record label, e.g. "LOG 001". */
  label: string;
  /** Series label, e.g. "THROWBACK / 001". Optional; a record may belong to a
      named series that numbers independently of its LOG number (CLAUDE.md §5.2). */
  series?: string;
  /** Lab stage token, e.g. "IN PROGRESS". */
  stage?: string;
  /** Thread tags, joined with " / ". */
  tags?: string[];
}

const { label, series, stage, tags = [] } = Astro.props;
---

<div class="stamp">
  <span class="stamp__label">{label}</span>
  {
    series && (
      <>
        <span class="stamp__sep">·</span>
        <span class="stamp__series">{series}</span>
      </>
    )
  }
  <span class="stamp__sep">·</span>
  {stage && <StatusDot stage={stage} />}
  {
    tags.length > 0 && (
      <>
        <span class="stamp__sep">·</span>
        <span class="stamp__tags">{tags.join(' / ')}</span>
      </>
    )
  }
</div>

<style>
  .stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em 0.7em;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-60);
    font-variant-numeric: tabular-nums;
  }

  .stamp__label {
    color: var(--color-ink);
    font-weight: 500;
  }

  .stamp__sep {
    color: var(--color-ink-15);
  }

  /* Series label sits at full ink like the record label: both are identifiers,
     not metadata, and a reader citing "THROWBACK / 001" needs to find it. */
  .stamp__series {
    color: var(--color-ink);
    font-weight: 500;
  }

  .stamp__tags {
    color: var(--color-ink-60);
  }
</style>
