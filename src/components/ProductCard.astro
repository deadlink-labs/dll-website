---
// ProductCard — a product presented as a device-screen tile: a dark screen
// (the eventual UI capture) above a caption. Until a real capture exists the
// screen shows an honest "capture pending" placeholder on a blueprint grid —
// the site never fakes an artifact (§8). When `web-image` lands, the real
// screenshot drops into the same frame with no layout change.
//
// The screen is always dark (graphite/display); the caption adapts to its
// context through --pc-* custom properties (ink on paper, light on graphite),
// so one component works in the light Products index and the dark Home band.
import { Image } from 'astro:assets';
import StatusDot from './StatusDot.astro';
import type { ProductEntry } from '../lib/content';

interface Props {
  entry: ProductEntry;
}
const { entry } = Astro.props;
const { image } = entry.data;
const screenLabel = `${entry.data.title} UI`;
---

<a class="product" href={`/products/${entry.id}`}>
  <div class="product__screen">
    {
      image ? (
        <Image
          class="product__screen-img"
          src={image}
          alt={screenLabel}
          format="webp"
          widths={[320, 640, 960, 1280]}
          sizes="(max-width: 760px) 100vw, 480px"
          loading="lazy"
        />
      ) : (
        <>
          <span class="product__screen-cap">Capture pending</span>
          <span class="product__screen-sub">{screenLabel}</span>
        </>
      )
    }
  </div>
  <div class="product__meta">
    <span class="product__status">
      <StatusDot stage={entry.data.stage} />
    </span>
    <h3 class="product__title">{entry.data.title}</h3>
    {entry.data.snippet && <p class="product__snippet">{entry.data.snippet}</p>}
  </div>
</a>

<style>
  .product {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--pc-line, var(--color-ink-15));
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }
  .product:hover {
    border-color: var(--pc-line-strong, var(--color-ink));
  }

  /* The screen: a recessed dark display on a faint blueprint grid. */
  .product__screen {
    position: relative;
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 16px;
    background-color: var(--color-panel-deep);
    background-image:
      linear-gradient(var(--color-on-panel-08) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-on-panel-08) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .product__screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
  }
  .product__screen-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-on-panel-60);
  }
  .product__screen-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-on-panel-30);
  }

  .product__meta {
    padding: 1.125rem 1.25rem 1.3rem;
  }
  .product__status {
    display: block;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .product__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--pc-fg, var(--color-ink));
  }
  .product:hover .product__title {
    color: var(--color-signal);
  }
  .product__snippet {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--pc-fg-60, var(--color-ink-75));
    max-width: 48ch;
  }
</style>
