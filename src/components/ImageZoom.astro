---
// Click-to-zoom for a record's images (log posts and product pages).
// Photographs are evidence (CLAUDE.md §3) and the 720px column downscales
// them; a portrait capture lands at ~465px. The build already ships each body
// image at its original pixel size (no srcset on markdown images), so the zoom
// shows the file we have, it never fetches a second one.
//
// Two mechanisms, because the page has two kinds of picture:
//
// 1. Raster <img> (prose images, the hero) go through medium-zoom (MIT, ~3 KB,
//    no dependencies): the Medium.com pattern, the image scales in place toward
//    the viewport, an overlay dims the page, and a click, Escape or a scroll
//    brings it back. Touch works (tap, swipe).
// 2. Specimen diagrams are inline <svg> (remark-svg-specimen inlines them so
//    the text inherits the page webfont). medium-zoom only takes <img>, and
//    rasterising a diagram for the zoom would lose Plex Mono, so those open in
//    a native <dialog>: the vector is cloned in and scaled to the window, sharp
//    at any size, with the same overlay look. Escape and click close it.
---

<script>
  import mediumZoom from 'medium-zoom';

  const OVERLAY = 'rgba(18, 18, 20, 0.78)';
  const VERTICAL_AIR = 24;

  const openOnKey = (el: Element, open: () => void) => {
    (el as HTMLElement).tabIndex = 0;
    el.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Enter' || key === ' ') {
        e.preventDefault();
        open();
      }
    });
  };

  /* 1. Raster images: prose body plus the hero at the top of the record. */
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>('.prose img, .record__media img, .product-page__media img'),
  );
  if (images.length > 0) {
    for (const img of images) {
      // medium-zoom sizes the zoom as min(natural size, viewport). That rule
      // keeps a 632px screenshot at 632px, which in a 720px column means a
      // click dims the page and nothing grows. The lightboxes people expect
      // (PhotoSwipe, Fancybox) fit the image to the viewport and upscale when
      // they must, and the library has no option for it. It reads
      // naturalWidth/Height off the element, so an own property shadows the
      // prototype getter and the viewport becomes the only cap.
      Object.defineProperty(img, 'naturalWidth', { value: Number.MAX_SAFE_INTEGER });
      Object.defineProperty(img, 'naturalHeight', { value: Number.MAX_SAFE_INTEGER });
    }

    const zoom = mediumZoom(images, {
      // Edge to edge sideways, 24px of air above and below: a picture that
      // touches the top and bottom of the window looks jammed. `margin` is
      // all four sides; `container` insets are per side.
      margin: 0,
      container: { top: VERTICAL_AIR, bottom: VERTICAL_AIR },
      // Neutral graphite, not the warm --color-panel-deep: through the blur,
      // the warm dark over the warm paper read as muddy brown. The overlay
      // is a fixed div, so rgba() is the one way to pass a colour here.
      background: OVERLAY,
    });

    // The library handles mouse and touch, and Escape to close, but an <img>
    // is not focusable, so the zoom cannot be opened from the keyboard on its
    // own. Focus never leaves the image, so after Escape the ring is where the
    // reader left it.
    for (const img of images) openOnKey(img, () => zoom.open({ target: img }));

    // The hero carries a srcset sized for the 720px column. `open` fires
    // before the library clones the image, so this is the moment to point the
    // hero at its largest candidate and drop the srcset: the clone then
    // carries the sharp file and takes the same fit-to-viewport path as the
    // body images (with a srcset the library reads the real natural size of
    // the loaded candidate and stops there). One-time per image; the page
    // hero keeps showing the current file until the large one has decoded.
    zoom.on('open', (e) => {
      const img = e.target as HTMLImageElement;
      if (!img.srcset) return;
      const largest = img.srcset
        .split(',')
        .map((c) => c.trim().split(/\s+/))
        .map(([url, w]) => ({ url, w: parseInt(w ?? '0', 10) || 0 }))
        .sort((a, b) => b.w - a.w)[0];
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      if (largest) img.src = largest.url;
    });
  }

  /* 2. Specimen diagrams: inline SVG into a native modal dialog. */
  const specimens = Array.from(document.querySelectorAll<SVGSVGElement>('.prose .specimen-fig svg'));
  if (specimens.length > 0) {
    const dialog = document.createElement('dialog');
    dialog.className = 'specimen-zoom';
    document.body.append(dialog);
    // A click anywhere (the drawing or the backdrop) closes, like the raster zoom.
    dialog.addEventListener('click', () => dialog.close());
    // showModal() returns focus to the element that opened it on close.
    dialog.addEventListener('close', () => dialog.replaceChildren());

    // Size the clone to the drawing, not the dialog: an svg left at 100% x
    // 100% letterboxes the picture inside an invisible box, so the corner
    // radius lands on the box and the picture runs into the side edges. Fit
    // the viewBox ratio inside the window minus the air, and again on resize.
    const fit = () => {
      const clone = dialog.firstElementChild as SVGSVGElement | null;
      if (!clone) return;
      const vb = clone.viewBox.baseVal;
      const ratio = vb.width && vb.height ? vb.width / vb.height : 16 / 9;
      const maxW = window.innerWidth - VERTICAL_AIR * 2;
      const maxH = window.innerHeight - VERTICAL_AIR * 2;
      const w = Math.min(maxW, maxH * ratio);
      clone.style.width = `${w}px`;
      clone.style.height = `${w / ratio}px`;
    };
    window.addEventListener('resize', fit);

    const open = (svg: SVGSVGElement) => {
      const clone = svg.cloneNode(true) as SVGSVGElement;
      // The viewBox does the scaling; the file's width/height would pin it.
      clone.removeAttribute('width');
      clone.removeAttribute('height');
      clone.removeAttribute('id');
      // The original is tabbable (openOnKey); the clone must not be, or
      // showModal() focuses it and draws a ring inside the dialog.
      clone.removeAttribute('tabindex');
      dialog.replaceChildren(clone);
      fit();
      dialog.showModal();
    };

    for (const svg of specimens) {
      svg.style.cursor = 'zoom-in';
      svg.addEventListener('click', () => open(svg));
      openOnKey(svg, () => open(svg));
    }
  }
</script>

<style is:global>
  /* --- medium-zoom (raster). The library injects its base styles; these sit
     on top. The sticky Nav is z-index 20 (Nav.astro), so the overlay and the
     zoomed clone go above it. */
  .medium-zoom-overlay {
    z-index: 30;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .medium-zoom-image--opened {
    z-index: 31;
    border-radius: 4px;
    /* The hero is cropped to 16:9 on the page (object-fit: cover). The zoomed
       clone keeps that box but shows the whole file; contain letterboxes a
       source that is not 16:9 instead of squashing it. No effect on body
       images, whose box already matches the file. */
    object-fit: contain;
  }
  /* Reduced motion: near-instant, not `none`. The library finishes open/close
     on `transitionend`; a transition that never runs would leave the overlay
     in the DOM. 1ms still fires the event and reads as instant. */
  @media (prefers-reduced-motion: reduce) {
    .medium-zoom-image,
    .medium-zoom-overlay {
      transition-duration: 1ms !important;
    }
  }

  /* --- specimen dialog (vector). Same overlay as above, on ::backdrop. */
  .specimen-zoom {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
    /* Centre the drawing; the script sizes it to the window minus the air. */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .specimen-zoom::backdrop {
    background: rgba(18, 18, 20, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  /* showModal() focuses the dialog itself (nothing inside is focusable) and
     the browser draws its default ring around the whole viewport. Escape and
     click are the exits; the ring says nothing here. */
  .specimen-zoom:focus,
  .specimen-zoom:focus-visible,
  .specimen-zoom svg:focus,
  .specimen-zoom svg:focus-visible {
    outline: none;
  }
  .specimen-zoom svg {
    display: block;
    flex: none;
    border-radius: 4px;
    /* border-radius alone does not clip an inline svg's own ground rect. */
    clip-path: inset(0 round 4px);
  }
  /* Graphite tiles carry no font-family and inherit the page webfont in the
     prose ([slug].astro); the clone lives outside .prose, so repeat it here. */
  .specimen-zoom svg text:not([font-family]) {
    font-family: var(--font-mono);
  }
  /* A short fade in, matching the raster zoom's 0.3s. @starting-style is what
     lets a dialog transition from its closed state; older engines skip it and
     the dialog simply appears. */
  .specimen-zoom[open],
  .specimen-zoom[open]::backdrop {
    opacity: 1;
    transition: opacity 0.3s ease;
    @starting-style {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .specimen-zoom[open],
    .specimen-zoom[open]::backdrop {
      transition: none;
    }
  }
</style>
