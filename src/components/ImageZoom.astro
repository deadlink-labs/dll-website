---
// Click-to-zoom for a record's images (log posts and product pages).
// Photographs are evidence (CLAUDE.md §3) and the 720px column downscales
// them; a portrait capture lands at ~465px. The build already ships each body
// image at its original pixel size (no srcset on markdown images), so the zoom
// shows the file we have, it never fetches a second one.
//
// Two mechanisms, because the page has two kinds of picture:
//
// 1. Raster <img> (prose images, the hero) go through medium-zoom (MIT, ~3 KB,
//    no dependencies): the Medium.com pattern, the image scales in place toward
//    the viewport, an overlay dims the page, and a click, Escape or a scroll
//    brings it back. Touch works (tap, swipe).
// 2. Specimen diagrams are inline <svg> (remark-svg-specimen inlines them so
//    the text inherits the page webfont). medium-zoom only takes <img>, and
//    rasterising a diagram for the zoom would lose Plex Mono, so the script
//    walks the vector through the library's own choreography: a clone over
//    the drawing's spot, the library's overlay and classes, the same scale
//    transform. One look, one timing, one set of CSS rules for both.
---

<script>
  import mediumZoom from 'medium-zoom';

  const OVERLAY = 'rgba(18, 18, 20, 0.78)';
  const AIR = 24;

  const openOnKey = (el: Element, open: () => void) => {
    (el as HTMLElement).tabIndex = 0;
    el.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Enter' || key === ' ') {
        e.preventDefault();
        open();
      }
    });
  };

  /* 1. Raster images: prose body plus the hero at the top of the record. */
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>('.prose img, .record__media img, .product-page__media img'),
  );
  if (images.length > 0) {
    for (const img of images) {
      // medium-zoom sizes the zoom as min(natural size, viewport). That rule
      // keeps a 632px screenshot at 632px, which in a 720px column means a
      // click dims the page and nothing grows. The lightboxes people expect
      // (PhotoSwipe, Fancybox) fit the image to the viewport and upscale when
      // they must, and the library has no option for it. It reads
      // naturalWidth/Height off the element, so an own property shadows the
      // prototype getter and the viewport becomes the only cap.
      Object.defineProperty(img, 'naturalWidth', { value: Number.MAX_SAFE_INTEGER });
      Object.defineProperty(img, 'naturalHeight', { value: Number.MAX_SAFE_INTEGER });
    }

    const zoom = mediumZoom(images, {
      // 24px of air on every side: a picture that touches the window edge
      // looks jammed, and a 16:9 one touched both sides.
      margin: AIR,
      // Neutral graphite, not the warm --color-panel-deep: through the blur,
      // the warm dark over the warm paper read as muddy brown. The overlay
      // is a fixed div, so rgba() is the one way to pass a colour here.
      background: OVERLAY,
    });

    // The library handles mouse and touch, and Escape to close, but an <img>
    // is not focusable, so the zoom cannot be opened from the keyboard on its
    // own. Focus never leaves the image, so after Escape the ring is where the
    // reader left it.
    for (const img of images) openOnKey(img, () => zoom.open({ target: img }));

    // The hero carries a srcset sized for the 720px column. `open` fires
    // before the library clones the image, so this is the moment to point the
    // hero at its largest candidate and drop the srcset: the clone then
    // carries the sharp file and takes the same fit-to-viewport path as the
    // body images (with a srcset the library reads the real natural size of
    // the loaded candidate and stops there). One-time per image; the page
    // hero keeps showing the current file until the large one has decoded.
    zoom.on('open', (e) => {
      const img = e.target as HTMLImageElement;
      if (!img.srcset) return;
      const largest = img.srcset
        .split(',')
        .map((c) => c.trim().split(/\s+/))
        .map(([url, w]) => ({ url, w: parseInt(w ?? '0', 10) || 0 }))
        .sort((a, b) => b.w - a.w)[0];
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      if (largest) img.src = largest.url;
    });
  }

  /* 2. Specimen diagrams: the vector through medium-zoom's choreography.
     Mirrors the library's open()/close(): clone at the original's rect,
     overlay, body class for the fade, one transform, transitionend to tidy.
     Reusing its class names means its injected CSS (transition, cursors)
     and the global rules below apply to both kinds without a second copy. */
  const specimens = Array.from(document.querySelectorAll<SVGSVGElement>('.prose .specimen-fig svg'));
  if (specimens.length > 0) {
    let active: { original: SVGSVGElement; clone: SVGSVGElement; overlay: HTMLDivElement } | null = null;

    const place = () => {
      if (!active) return;
      const { original, clone } = active;
      const { top, left, width, height } = original.getBoundingClientRect();
      // The library's formula with `margin: AIR`.
      const viewportWidth = window.innerWidth - AIR * 2;
      const viewportHeight = window.innerHeight - AIR * 2;
      const scale = Math.min(viewportWidth / width, viewportHeight / height);
      const translateX = (-left + (viewportWidth - width) / 2 + AIR) / scale;
      const translateY = (-top + (viewportHeight - height) / 2 + AIR) / scale;
      clone.style.transform = `scale(${scale}) translate3d(${translateX}px, ${translateY}px, 0)`;
    };

    const close = () => {
      if (!active) return;
      const { original, clone, overlay } = active;
      active = null;
      document.body.classList.remove('medium-zoom--opened');
      clone.style.transform = '';
      clone.addEventListener(
        'transitionend',
        () => {
          original.classList.remove('medium-zoom-image--hidden');
          clone.remove();
          overlay.remove();
        },
        { once: true },
      );
    };

    const open = (original: SVGSVGElement) => {
      if (active) return;
      const rect = original.getBoundingClientRect();
      const clone = original.cloneNode(true) as SVGSVGElement;
      clone.removeAttribute('id');
      clone.removeAttribute('tabindex'); // the original is tabbable (openOnKey)
      clone.classList.add('medium-zoom-image', 'medium-zoom-image--opened');
      clone.style.position = 'absolute';
      clone.style.top = `${rect.top + window.scrollY}px`;
      clone.style.left = `${rect.left + window.scrollX}px`;
      clone.style.width = `${rect.width}px`;
      clone.style.height = `${rect.height}px`;
      clone.addEventListener('click', close);

      const overlay = document.createElement('div');
      overlay.className = 'medium-zoom-overlay';
      overlay.style.background = OVERLAY;
      overlay.addEventListener('click', close);

      active = { original, clone, overlay };
      scrollAt = window.scrollY;
      original.classList.add('medium-zoom-image--hidden');
      document.body.append(overlay, clone);
      requestAnimationFrame(() => {
        document.body.classList.add('medium-zoom--opened');
        place();
      });
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    let scrollAt = 0; // scrollY at open, as the library records it
    window.addEventListener('scroll', () => {
      if (active && Math.abs(window.scrollY - scrollAt) > 40) close(); // the library's scrollOffset
    });
    window.addEventListener('resize', place);

    for (const svg of specimens) {
      svg.classList.add('medium-zoom-image'); // zoom-in cursor, from the library's CSS
      svg.addEventListener('click', () => open(svg));
      openOnKey(svg, () => open(svg));
    }
  }
</script>

<style is:global>
  /* The library injects its base styles; these sit on top, for both kinds. The sticky Nav is z-index 20 (Nav.astro), so the overlay and the
     zoomed clone go above it. */
  .medium-zoom-overlay {
    z-index: 30;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .medium-zoom-image--opened {
    z-index: 31;
    border-radius: 4px;
    /* The hero is cropped to 16:9 on the page (object-fit: cover). The zoomed
       clone keeps that box but shows the whole file; contain letterboxes a
       source that is not 16:9 instead of squashing it. No effect on body
       images, whose box already matches the file. */
    object-fit: contain;
  }
  /* Reduced motion: near-instant, not `none`. The library finishes open/close
     on `transitionend`; a transition that never runs would leave the overlay
     in the DOM. 1ms still fires the event and reads as instant. */
  @media (prefers-reduced-motion: reduce) {
    .medium-zoom-image,
    .medium-zoom-overlay {
      transition-duration: 1ms !important;
    }
  }

  /* The specimen clone lives outside .prose; repeat the prose font rule for
     graphite tiles, which carry no font-family of their own. */
  svg.medium-zoom-image--opened text:not([font-family]) {
    font-family: var(--font-mono);
  }
  /* border-radius alone does not clip an inline svg's own ground rect. */
  svg.medium-zoom-image--opened {
    clip-path: inset(0 round 4px);
  }
</style>
