---
// NetworkMark — the cover mark, per the settled Home design
// (Deadlink-Labs-Home.dc.html). An organic node network: settled ink nodes
// joined by hairlines, two work-in-progress signal links reaching the live
// node risen to the upper right. The dead link resolves.
//
// The SVG is server-rendered at its base positions, so the resolved mark is
// there at first paint and without JS. A small script then adds the life:
// slow node drift, a pointer pull toward the cursor, the halo pulse, and the
// breathing of the work-in-progress links.

const NODES: [number, number][] = [
  [128, 196], [96, 150], [156, 140], [140, 96], [200, 180],
  [204, 116], [252, 140], [232, 74], [292, 60],
];
const EDGES: [number, number][] = [
  [0, 1], [1, 2], [0, 2], [1, 3], [2, 3], [2, 4], [0, 4], [2, 5],
  [3, 5], [4, 5], [4, 6], [5, 6], [5, 7], [3, 7], [6, 7],
];
const WIP: [number, number][] = [[7, 8], [6, 8]]; // work-in-progress links to the live node
const LIVE = 8;
const OFF = 20; // shift graph coords into the 360x300 box

const pt = (i: number) => ({ x: NODES[i][0] + OFF, y: NODES[i][1] + OFF });
---

<svg class="network-mark" viewBox="0 45 360 200" aria-hidden="true">
  {
    [...EDGES, ...WIP].map(([a, b], i) => (
      <line
        class:list={['nm-line', { 'nm-line--wip': i >= EDGES.length }]}
        data-a={a}
        data-b={b}
        x1={pt(a).x}
        y1={pt(a).y}
        x2={pt(b).x}
        y2={pt(b).y}
      />
    ))
  }
  {
    NODES.map((_, i) => (
      <circle
        class:list={['nm-node', { 'nm-node--live': i === LIVE }]}
        cx={pt(i).x}
        cy={pt(i).y}
        r={i === LIVE ? 6.2 : 3.4}
      />
    ))
  }
  <circle class="nm-halo" cx={pt(LIVE).x} cy={pt(LIVE).y} r="11" />
</svg>

<style>
  .network-mark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: none;
    cursor: crosshair;
  }

  .nm-line {
    stroke: var(--color-ink);
    stroke-width: 1.1;
    stroke-linecap: round;
    opacity: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .nm-line--wip {
    stroke: var(--color-signal);
    stroke-width: 1.3;
    opacity: 0.9;
  }

  .nm-node {
    fill: var(--color-ink);
  }

  .nm-node--live {
    fill: var(--color-signal);
  }

  .nm-halo {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 1.2;
    opacity: 0.3;
  }
</style>

<script>
  // Animates the server-rendered mark: drift + pointer pull + halo pulse.
  // Geometry is read back from the SVG itself, so the markup stays the only
  // source of truth for the graph.
  const svg = document.querySelector<SVGSVGElement>('.network-mark');

  if (svg) {
    const W = 360;
    const H = 300;
    const nodes = [...svg.querySelectorAll<SVGCircleElement>('.nm-node')];
    const lines = [...svg.querySelectorAll<SVGLineElement>('.nm-line')].map((el) => ({
      el,
      a: Number(el.dataset.a),
      b: Number(el.dataset.b),
      wip: el.classList.contains('nm-line--wip'),
    }));
    const halo = svg.querySelector<SVGCircleElement>('.nm-halo');
    const liveIndex = nodes.findIndex((n) => n.classList.contains('nm-node--live'));

    const base = nodes.map((c) => ({ x: Number(c.getAttribute('cx')), y: Number(c.getAttribute('cy')) }));
    const cur = base.map((p) => ({ ...p }));
    const phase = base.map(() => ({
      px: Math.random() * 6.28,
      py: Math.random() * 6.28,
      sx: 0.3 + Math.random() * 0.25,
      sy: 0.3 + Math.random() * 0.25,
      ax: 2.4 + Math.random() * 1.6,
      ay: 2.4 + Math.random() * 1.6,
    }));

    const mouse = { x: 0, y: 0, active: 0, eased: 0 };
    svg.addEventListener('pointermove', (ev) => {
      const r = svg.getBoundingClientRect();
      mouse.x = ((ev.clientX - r.left) / r.width) * W;
      mouse.y = ((ev.clientY - r.top) / r.height) * H;
      mouse.active = 1;
    });
    svg.addEventListener('pointerleave', () => {
      mouse.active = 0;
    });

    const t0 = performance.now();
    const tick = (ts: number) => {
      const t = (ts - t0) / 1000;
      mouse.eased += (mouse.active - mouse.eased) * 0.08;

      for (let i = 0; i < nodes.length; i++) {
        const b = base[i];
        const ph = phase[i];
        const cu = cur[i];
        let bx = b.x + Math.sin(t * ph.sx + ph.px) * ph.ax;
        let by = b.y + Math.cos(t * ph.sy + ph.py) * ph.ay;
        if (mouse.eased > 0.001) {
          const dx = mouse.x - bx;
          const dy = mouse.y - by;
          const d = Math.sqrt(dx * dx + dy * dy) + 0.001;
          const pull = Math.min(11, 810000 / (d * d * d)) * mouse.eased;
          bx += (dx / d) * pull;
          by += (dy / d) * pull;
        }
        cu.x += (bx - cu.x) * 0.12;
        cu.y += (by - cu.y) * 0.12;
        nodes[i].setAttribute('cx', cu.x.toFixed(2));
        nodes[i].setAttribute('cy', cu.y.toFixed(2));
      }

      if (halo && liveIndex >= 0) {
        const cu = cur[liveIndex];
        const pulse = 0.5 + 0.5 * Math.sin(t * 1.6);
        halo.setAttribute('cx', cu.x.toFixed(2));
        halo.setAttribute('cy', cu.y.toFixed(2));
        halo.setAttribute('r', (10 + pulse * 3).toFixed(2));
        halo.style.opacity = (0.16 + 0.34 * pulse).toFixed(3);
      }

      for (const l of lines) {
        const A = cur[l.a];
        const B = cur[l.b];
        l.el.setAttribute('x1', A.x.toFixed(2));
        l.el.setAttribute('y1', A.y.toFixed(2));
        l.el.setAttribute('x2', B.x.toFixed(2));
        l.el.setAttribute('y2', B.y.toFixed(2));
        if (l.wip) l.el.style.opacity = (0.55 + 0.4 * (0.5 + 0.5 * Math.sin(t * 1.6 + 0.4))).toFixed(3);
      }

      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
