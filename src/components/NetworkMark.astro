---
// NetworkMark — the 8A "Bridge Truss" brand mark (CLAUDE.md §2/§3).
// A truss of ink nodes + 1px hairlines that thins as it rises left→right and
// bottom→top, resolving onto a single larger live signal-orange node at the
// top-right frontier. "The dead link resolves." Used on the homepage cover and
// as the logo. Geometry is generated at build time; the mark ships as static
// SVG and animates in on load with pure-CSS keyframes (settle + draw-in),
// respecting prefers-reduced-motion.

interface Props {
  /** Run the settle/draw-in entrance. Set false to render the resolved mark. */
  animate?: boolean;
  /** Accessible label; the mark is decorative by default. */
  title?: string;
}

const { animate = true, title } = Astro.props;

const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

// Two chords rising left→right. The gap between them narrows as it climbs, so
// the truss thins toward the frontier. Left bays are crossed (denser); right
// bays carry a single diagonal (sparser) and resolve onto the live node.
const CH = {
  bx0: 34, bx1: 420, by0: 248, by1: 84, // bottom chord
  tx0: 34, tx1: 420, ty0: 166, ty1: 80, // top chord
};
const PANELS = 5; // inner nodes B0..B4 / T0..T4, then the live apex

type Node = { x: number; y: number; r: number; live: boolean; d: number };
type Seg = { x1: number; y1: number; x2: number; y2: number; d: number };

const B: { x: number; y: number }[] = [];
const T: { x: number; y: number }[] = [];
for (let i = 0; i < PANELS; i++) {
  const t = i / PANELS; // 0, .2, .4, .6, .8 — inner nodes stop short of the apex
  B.push({ x: lerp(CH.bx0, CH.bx1, t), y: lerp(CH.by0, CH.by1, t) });
  T.push({ x: lerp(CH.tx0, CH.tx1, t), y: lerp(CH.ty0, CH.ty1, t) });
}
// The live node: the single resolved frontier, top-right.
const L = { x: 432, y: 74 };

// Stagger: a wave of settle rising from the dense bottom-left to the live node.
const SPREAD = 0.8;
const X0 = CH.bx0;
const X1 = L.x;
const tOf = (x: number) => (x - X0) / (X1 - X0);
const delayOf = (x: number) => +(tOf(x) * SPREAD).toFixed(3);

const nodes: Node[] = [];
for (const p of B) nodes.push({ ...p, r: 3.8, live: false, d: delayOf(p.x) + 0.05 });
for (const p of T) nodes.push({ ...p, r: 3.8, live: false, d: delayOf(p.x) + 0.05 });
// Live node resolves last, with a slightly longer beat.
nodes.push({ ...L, r: 6.8, live: true, d: SPREAD + 0.22 });

const seg = (a: { x: number; y: number }, b: { x: number; y: number }): Seg => ({
  x1: a.x, y1: a.y, x2: b.x, y2: b.y,
  d: +(((delayOf(a.x) + delayOf(b.x)) / 2)).toFixed(3),
});

const segments: Seg[] = [];
// Chords
for (let i = 0; i < PANELS - 1; i++) {
  segments.push(seg(B[i], B[i + 1]));
  segments.push(seg(T[i], T[i + 1]));
}
segments.push(seg(B[PANELS - 1], L));
segments.push(seg(T[PANELS - 1], L));
// Verticals
for (let i = 0; i < PANELS; i++) segments.push(seg(B[i], T[i]));
// Diagonals — alternating; left two bays crossed for density.
for (let p = 0; p < PANELS - 1; p++) {
  const main = p % 2 === 0 ? seg(B[p], T[p + 1]) : seg(T[p], B[p + 1]);
  segments.push(main);
  if (p <= 1) {
    const cross = p % 2 === 0 ? seg(T[p], B[p + 1]) : seg(B[p], T[p + 1]);
    segments.push(cross);
  }
}

// Tight viewBox hugging the truss (incl. the live node's halo) so the mark
// carries no dead space and centers cleanly on the cover.
const HALO_R = 13;
const PAD = 6;
let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
for (const n of nodes) {
  const rr = n.live ? HALO_R : n.r;
  minX = Math.min(minX, n.x - rr);
  minY = Math.min(minY, n.y - rr);
  maxX = Math.max(maxX, n.x + rr);
  maxY = Math.max(maxY, n.y + rr);
}
const vbX = +(minX - PAD).toFixed(2);
const vbY = +(minY - PAD).toFixed(2);
const vbW = +(maxX - minX + PAD * 2).toFixed(2);
const vbH = +(maxY - minY + PAD * 2).toFixed(2);
---

<svg
  class:list={['mark', { 'mark--animate': animate }]}
  viewBox={`${vbX} ${vbY} ${vbW} ${vbH}`}
  fill="none"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <g class="mark__web">
    {segments.map((s) => (
      <line
        x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2}
        pathLength="1"
        style={`--d:${s.d}s`}
      />
    ))}
  </g>
  <!-- faint frontier ring around the live node -->
  <circle
    class="mark__halo"
    cx={L.x} cy={L.y} r="13"
    style={`--d:${SPREAD + 0.22}s`}
  />
  <g class="mark__nodes">
    {nodes.map((n) => (
      <circle
        class:list={['node', { 'node--live': n.live }]}
        cx={n.x} cy={n.y} r={n.r}
        style={`--d:${n.d}s`}
      />
    ))}
  </g>
</svg>

<style>
  .mark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Resolved (default / reduced-motion) state — fully drawn. */
  .mark__web line {
    stroke: var(--color-ink);
    stroke-width: 1;
    stroke-opacity: 0.85;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke; /* keep 1px hairlines at any scale */
  }

  .node {
    fill: var(--color-ink);
  }

  .node--live {
    fill: var(--color-signal);
  }

  .mark__halo {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 1;
    stroke-opacity: 0.28;
    vector-effect: non-scaling-stroke;
  }

  /* Entrance — only when motion is welcome. Reduced-motion users get the
     resolved mark above with zero animation and zero flash. */
  @media (prefers-reduced-motion: no-preference) {
    .mark--animate .mark__web line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: mark-draw 0.55s ease forwards;
      animation-delay: var(--d);
    }

    .mark--animate .node,
    .mark--animate .mark__halo {
      opacity: 0;
      transform: scale(0.5);
      transform-box: fill-box;
      transform-origin: center;
      animation: mark-settle 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d);
    }

    .mark--animate .mark__halo {
      animation-duration: 0.7s;
    }
  }

  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes mark-settle {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
